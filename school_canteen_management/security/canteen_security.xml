<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_canteen" model="ir.module.category">
        <field name="name">Canteen Management</field>
        <field name="sequence">20</field>
    </record>

    <!-- Odoo 19 moved the "Application" grouping off res.groups.category_id
         and onto a new res.groups.privilege record (res.groups now links
         to it via privilege_id). -->
    <record id="privilege_canteen" model="res.groups.privilege">
        <field name="name">Canteen Management</field>
        <field name="category_id" ref="module_category_canteen"/>
    </record>

    <record id="group_canteen_operator" model="res.groups">
        <field name="name">Canteen Counter Operator</field>
        <field name="privilege_id" ref="privilege_canteen"/>
    </record>

    <record id="group_canteen_manager" model="res.groups">
        <field name="name">Canteen Manager</field>
        <field name="privilege_id" ref="privilege_canteen"/>
        <field name="implied_ids" eval="[(4, ref('group_canteen_operator'))]"/>
    </record>

    <record id="canteen_order_rule_own" model="ir.rule">
        <field name="name">Canteen Order: Own Orders (Portal)</field>
        <field name="model_id" ref="model_canteen_order"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>