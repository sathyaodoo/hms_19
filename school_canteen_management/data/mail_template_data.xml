<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_low_balance" model="mail.template">
        <field name="name">Canteen: Low Wallet Balance Alert</field>
        <field name="model_id" ref="model_student_wallet"/>
        <field name="subject">Low Canteen Wallet Balance - {{ object.partner_id.name }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Dear {{ object.partner_id.name }},</p>
                <p>Your canteen wallet balance is low:
                   <strong><t t-out="object.balance"/></strong>.</p>
                <p>Please top up your wallet to continue using canteen
                   services without interruption.</p>
                <p>Regards,<br/>Canteen Team</p>
            </div>
        </field>
    </record>
</odoo>
