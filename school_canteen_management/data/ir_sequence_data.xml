<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_canteen_order_token" model="ir.sequence">
        <field name="name">Canteen Order Token</field>
        <field name="code">canteen.order.token</field>
        <field name="prefix">TKN/%(y)s%(month)s%(day)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
