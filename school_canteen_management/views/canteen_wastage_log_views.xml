<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_canteen_wastage_log_list" model="ir.ui.view">
        <field name="name">canteen.wastage.log.list</field>
        <field name="model">canteen.wastage.log</field>
        <field name="arch" type="xml">
            <list string="Wastage / Spoilage Log">
                <field name="date"/>
                <field name="menu_item_id"/>
                <field name="qty_wasted"/>
                <field name="reason"/>
                <field name="cost_impact" sum="Total Cost Impact"/>
            </list>
        </field>
    </record>

    <record id="view_canteen_wastage_log_form" model="ir.ui.view">
        <field name="name">canteen.wastage.log.form</field>
        <field name="model">canteen.wastage.log</field>
        <field name="arch" type="xml">
            <form string="Wastage Log">
                <sheet>
                    <group>
                        <group>
                            <field name="menu_item_id"/>
                            <field name="qty_wasted"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="cost_impact" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Additional notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_canteen_wastage_log" model="ir.actions.act_window">
        <field name="name">Wastage / Spoilage Log</field>
        <field name="res_model">canteen.wastage.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
