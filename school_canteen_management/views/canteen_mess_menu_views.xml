<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_canteen_mess_menu_list" model="ir.ui.view">
        <field name="name">canteen.mess.menu.list</field>
        <field name="model">canteen.mess.menu</field>
        <field name="arch" type="xml">
            <list string="Hostel Mess Plans">
                <field name="name"/>
                <field name="hostel_id"/>
                <field name="meal_plan_type"/>
                <field name="price"/>
            </list>
        </field>
    </record>

    <record id="view_canteen_mess_menu_form" model="ir.ui.view">
        <field name="name">canteen.mess.menu.form</field>
        <field name="model">canteen.mess.menu</field>
        <field name="arch" type="xml">
            <form string="Hostel Mess Plan">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="hostel_id"/>
                            <field name="meal_plan_type"/>
                            <field name="price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Meal Lines">
                            <field name="meal_line_ids">
                                <list editable="bottom">
                                    <field name="day"/>
                                    <field name="meal_type"/>
                                    <field name="menu_item_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                        <page string="Subscribed Students">
                            <field name="student_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_canteen_mess_menu" model="ir.actions.act_window">
        <field name="name">Hostel Mess Plans</field>
        <field name="res_model">canteen.mess.menu</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
