<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_wallet_list" model="ir.ui.view">
        <field name="name">student.wallet.list</field>
        <field name="model">student.wallet</field>
        <field name="arch" type="xml">
            <list string="Student Wallets" decoration-danger="balance &lt;= low_balance_threshold">
                <field name="partner_id"/>
                <field name="balance"/>
                <field name="low_balance_threshold"/>
            </list>
        </field>
    </record>

    <record id="view_student_wallet_form" model="ir.ui.view">
        <field name="name">student.wallet.form</field>
        <field name="model">student.wallet</field>
        <field name="arch" type="xml">
            <form string="Student Wallet">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_id"/></h1>
                    </div>
                    <group>
                        <field name="balance"/>
                        <field name="low_balance_threshold"/>
                    </group>
                    <notebook>
                        <page string="Transactions">
                            <field name="transaction_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="transaction_type"/>
                                    <field name="source"/>
                                    <field name="amount"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_student_wallet" model="ir.actions.act_window">
        <field name="name">Student Wallets</field>
        <field name="res_model">student.wallet</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
