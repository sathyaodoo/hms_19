<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_canteen_order_list" model="ir.ui.view">
        <field name="name">canteen.order.list</field>
        <field name="model">canteen.order</field>
        <field name="arch" type="xml">
            <list string="Canteen Orders" decoration-success="state=='collected'"
                  decoration-info="state=='ready'" decoration-muted="state=='cancelled'">
                <field name="token_number"/>
                <field name="partner_id"/>
                <field name="order_date"/>
                <field name="pickup_time_slot"/>
                <field name="amount_total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_canteen_order_form" model="ir.ui.view">
        <field name="name">canteen.order.form</field>
        <field name="model">canteen.order</field>
        <field name="arch" type="xml">
            <form string="Canteen Order">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_mark_ready" string="Mark Ready" type="object"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_collect" string="Mark Collected" type="object"
                            invisible="state != 'ready'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('collected','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,ready,collected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="token_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="order_date"/>
                            <field name="pickup_time_slot"/>
                        </group>
                        <group>
                            <field name="qr_code" widget="image" class="oe_avatar"/>
                            <field name="pos_order_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="order_line_ids">
                        <list editable="bottom">
                            <field name="menu_item_id"/>
                            <field name="qty"/>
                            <field name="price_unit"/>
                            <field name="price_subtotal" sum="Total"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount_total"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_canteen_order" model="ir.actions.act_window">
        <field name="name">Canteen Orders / Tokens</field>
        <field name="res_model">canteen.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
