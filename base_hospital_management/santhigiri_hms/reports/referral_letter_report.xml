<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_referral_letter" model="ir.actions.report">
        <field name="name">Casualty Referral Letter</field>
        <field name="model">hospital.casualty</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">santhigiri_hms.report_referral_letter</field>
        <field name="print_report_name">'Referral_Letter_' + (object.casualty_reference or '')</field>
        <field name="binding_model_id" ref="model_hospital_casualty"/>
    </record>

    <template id="report_referral_letter">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row">
                            <div class="col-12 text-center">
                                <h3>SANTHIGIRI AYURVEDA HOSPITAL</h3>
                                <h5>Thiruvananthapuram, Kerala</h5>
                                <h4 class="mt-2"><u>CASUALTY REFERRAL LETTER</u></h4>
                            </div>
                        </div>
                        <hr/>
                        <div class="row mt-3">
                            <div class="col-6"><strong>Ref No:</strong> <t t-esc="doc.casualty_reference"/></div>
                            <div class="col-6 text-end">
                                <strong>Date:</strong>
                                <t t-esc="doc.registration_datetime" t-options='{"widget":"datetime","format":"dd/MM/yyyy"}'/>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12">
                                <p>To,<br/>The Attending Physician,<br/>
                                <strong><t t-esc="doc.referral_hospital or 'Receiving Hospital'"/></strong></p>
                            </div>
                        </div>
                        <p><strong>Sub: Referral of Patient — <t t-esc="doc.patient_id.name"/></strong></p>
                        <hr/>
                        <table class="table table-bordered">
                            <tr>
                                <td><strong>Patient Name</strong></td><td><t t-esc="doc.patient_id.name"/></td>
                                <td><strong>Patient No.</strong></td><td><t t-esc="doc.patient_seq or ''"/></td>
                            </tr>
                            <tr>
                                <td><strong>Blood Group</strong></td><td><t t-esc="doc.blood_group or ''"/></td>
                                <td><strong>Allergies</strong></td><td><t t-esc="doc.allergy_summary or 'NIL'"/></td>
                            </tr>
                        </table>
                        <h5 class="mt-3">Vitals at Presentation</h5>
                        <table class="table table-bordered">
                            <tr>
                                <td>BP: <t t-esc="doc.bp or '—'"/></td>
                                <td>Pulse: <t t-esc="doc.pulse or '—'"/> bpm</td>
                                <td>Temp: <t t-esc="doc.temperature or '—'"/>°F</td>
                                <td>SpO2: <t t-esc="doc.spo2 or '—'"/>%</td>
                            </tr>
                        </table>
                        <h5 class="mt-3">Chief Complaint</h5>
                        <p><t t-esc="doc.chief_complaint or ''"/></p>
                        <h5>Clinical History</h5>
                        <p><t t-esc="doc.clinical_history or 'As above'"/></p>
                        <h5>Examination Findings</h5>
                        <p><t t-esc="doc.examination_findings or 'As documented'"/></p>
                        <h5>Provisional Diagnosis</h5>
                        <p><t t-esc="doc.provisional_diagnosis or '—'"/></p>
                        <h5>Reason for Referral</h5>
                        <p><t t-esc="doc.referral_reason or '—'"/></p>
                        <t t-if="doc.ambulance_no">
                            <h5>Transfer Details</h5>
                            <p>Ambulance/Mode: <t t-esc="doc.ambulance_no"/>
                            <t t-if="doc.accompanying_staff_id">
                                | Accompanying: <t t-esc="doc.accompanying_staff_id.name"/>
                            </t></p>
                        </t>
                        <div class="row mt-5">
                            <div class="col-6">
                                <p>RMO Signature:<br/><br/>__________________________<br/>
                                <t t-esc="doc.rmo_id.name if doc.rmo_id else ''"/></p>
                            </div>
                            <div class="col-6 text-end">
                                <p>Hospital Seal &amp; Date:<br/><br/>__________________________</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>