<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_bystander_pass" model="ir.actions.report">
        <field name="name">Bystander Pass</field>
        <field name="model">hospital.inpatient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">santhigiri_hms.report_bystander_pass</field>
        <field name="print_report_name">'Bystander_Pass_' + (object.bystander_pass_no or '')</field>
    </record>

    <template id="report_bystander_pass">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="border: 2px solid #1F4E78; padding: 20px; max-width: 400px; margin: auto;">
                    <div class="text-center">
                        <h4>SANTHIGIRI AYURVEDA HOSPITAL</h4>
                        <h5>BYSTANDER PASS</h5>
                        <hr/>
                    </div>
                    <table class="table table-bordered">
                        <tr><td><strong>Pass No.</strong></td><td><t t-esc="doc.bystander_pass_no"/></td></tr>
                        <tr><td><strong>Patient Name</strong></td><td><t t-esc="doc.patient_id.name"/></td></tr>
                        <tr><td><strong>Ward / Room</strong></td>
                            <td><t t-esc="doc.ward_id.ward_no if doc.ward_id else ''"/> / <t t-esc="doc.room_id.name if doc.room_id else ''"/></td></tr>
                        <tr><td><strong>Bystander Name</strong></td><td><t t-esc="doc.bystander_name"/></td></tr>
                        <tr><td><strong>Relation</strong></td><td><t t-esc="doc.bystander_relation"/></td></tr>
                        <tr><td><strong>Valid Date</strong></td>
                            <td><t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/></td></tr>
                    </table>
                    <p class="text-center mt-2"><small>This pass is valid for one day only. Report to security at the ward entrance.</small></p>
                </div>
            </t>
        </t>
    </template>
</odoo>