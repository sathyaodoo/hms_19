<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_camp" model="ir.actions.report">
        <field name="name">Medical Camp Report</field>
        <field name="model">hospital.camp</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">santhigiri_hms.camp_report_template</field>
        <field name="report_file">santhigiri_hms.camp_report_template</field>
        <field name="binding_model_id" ref="model_hospital_camp"/>
        <field name="binding_type">report</field>
    </record>

    <template id="camp_report_template">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>Medical Camp Report</h2>
                            <h3><t t-esc="doc.name"/></h3>
                        </div>

                        <!-- Camp Details -->
                        <table class="table table-bordered mb-4">
                            <tr>
                                <td><strong>Camp Date</strong></td>
                                <td><t t-esc="doc.camp_date"/></td>
                                <td><strong>Location</strong></td>
                                <td><t t-esc="doc.location or '-'"/></td>
                            </tr>
                            <tr>
                                <td><strong>Speciality</strong></td>
                                <td><t t-esc="doc.speciality or '-'"/></td>
                                <td><strong>Department</strong></td>
                                <td><t t-esc="doc.organiser_dept_id.name or '-'"/></td>
                            </tr>
                            <tr>
                                <td><strong>Sponsor</strong></td>
                                <td><t t-esc="doc.sponsor or '-'"/></td>
                                <td><strong>Discount Type</strong></td>
                                <td><t t-esc="doc.discount_type"/></td>
                            </tr>
                        </table>

                        <!-- Patients List -->
                        <h4>Patients Seen (<t t-esc="doc.total_patients"/>)</h4>
                        <table class="table table-sm table-bordered mb-4">
                            <thead class="table-primary">
                                <tr>
                                    <th>#</th>
                                    <th>Patient Name</th>
                                    <th>OP Reference</th>
                                    <th>Doctor</th>
                                    <th>Date</th>
                                    <th>Service Value</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="sno" t-value="0"/>
                                <t t-foreach="doc.outpatient_ids" t-as="op">
                                    <t t-set="sno" t-value="sno + 1"/>
                                    <tr>
                                        <td><t t-esc="sno"/></td>
                                        <td><t t-esc="op.patient_id.name"/></td>
                                        <td><t t-esc="op.op_reference"/></td>
                                        <td><t t-esc="op.doctor_id.name or '-'"/></td>
                                        <td><t t-esc="op.op_date"/></td>
                                        <td>₹ <t t-esc="'%.2f' % (op.category_fee or 0)"/></td>
                                        <td><t t-esc="op.state"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Financial Summary -->
                        <table class="table table-bordered"
                               style="width:50%; margin-left:auto;">
                            <tr class="table-light">
                                <td><strong>Total Patients Seen</strong></td>
                                <td class="text-end">
                                    <t t-esc="doc.total_patients"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Total Value of Services</strong></td>
                                <td class="text-end">
                                    ₹ <t t-esc="'%.2f' % doc.total_value"/>
                                </td>
                            </tr>
                            <tr class="table-warning">
                                <td><strong>Total Discount Given</strong></td>
                                <td class="text-end">
                                    ₹ <t t-esc="'%.2f' % doc.total_discount"/>
                                </td>
                            </tr>
                            <tr class="table-success">
                                <td><strong>Actual Revenue</strong></td>
                                <td class="text-end">
                                    <strong>
                                        ₹ <t t-esc="'%.2f' % doc.actual_revenue"/>
                                    </strong>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>