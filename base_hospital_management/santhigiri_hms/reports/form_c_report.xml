<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_form_c" model="ir.actions.report">
        <field name="name">Form C — Foreign Patient Report</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">santhigiri_hms.report_form_c</field>
        <field name="print_report_name">'FormC_' + (object.name or '')</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
    </record>

    <template id="report_form_c">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center">
                            <h4>FORM C</h4>
                            <h5>(Rule 14 of the Registration of Foreigners Rules, 1992)</h5>
                            <hr/>
                            <h5>SANTHIGIRI AYURVEDA HOSPITAL — Thiruvananthapuram</h5>
                        </div>
                        <p class="mt-3">Details of foreign national patient admitted to this hospital:</p>
                        <table class="table table-bordered">
                            <tr><td><strong>Full Name</strong></td><td><t t-esc="doc.name"/></td></tr>
                            <tr><td><strong>Nationality</strong></td><td>Foreign National</td></tr>
                            <tr><td><strong>Passport Number</strong></td><td><t t-esc="doc.passport_no or ''"/></td></tr>
                            <tr><td><strong>VISA Number</strong></td><td><t t-esc="doc.visa_no or ''"/></td></tr>
                            <tr><td><strong>VISA Type</strong></td><td><t t-esc="doc.visa_type or ''"/></td></tr>
                            <tr><td><strong>Arrival Date in India</strong></td>
                                <td><t t-esc="doc.arrival_date" t-options='{"widget":"date"}'/></td></tr>
                            <tr><td><strong>Port of Entry</strong></td><td><t t-esc="doc.port_of_entry or ''"/></td></tr>
                            <tr><td><strong>Patient ID (Hospital)</strong></td><td><t t-esc="doc.patient_seq or ''"/></td></tr>
                            <tr><td><strong>Address in India</strong></td>
                                <td><t t-esc="(doc.street or '') + ' ' + (doc.city or '')"/></td></tr>
                        </table>
                        <div class="row mt-4">
                            <div class="col-6">
                                <p>Authorised Signatory:<br/><br/>________________________<br/>Name &amp; Designation</p>
                            </div>
                            <div class="col-6 text-end">
                                <p>Hospital Stamp &amp; Date:<br/><br/>________________________</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>