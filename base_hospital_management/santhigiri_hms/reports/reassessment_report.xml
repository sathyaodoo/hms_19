<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_op_reassessment" model="ir.actions.report">
        <field name="name">OP Reassessment Chart</field>
        <field name="model">hospital.op.reassessment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">santhigiri_hms.report_op_reassessment</field>
        <field name="print_report_name">'OP_Reassessment_' + (object.reference or '')</field>
        <field name="binding_model_id" ref="model_hospital_op_reassessment"/>
    </record>

    <template id="report_op_reassessment_slip">
        <!-- One reassessment "slip" — reused twice per page, matching the printed form -->
        <div class="text-center">
            <h5><i>OP Reassessment Chart</i></h5>
        </div>
        <p>Form No : SAMC/CS/14</p>
        <table class="table table-borderless table-sm">
            <tr>
                <td><strong>Patient's Name:</strong> <t t-esc="doc.patient_id.name"/></td>
                <td><strong>Age:</strong> <t t-esc="doc.patient_id.age"/></td>
                <td><strong>Sex:</strong> <t t-esc="doc.patient_id.gender"/></td>
                <td><strong>UHID No:</strong> <t t-esc="doc.uhid_no"/></td>
            </tr>
            <tr>
                <td><strong>Date &amp; Time:</strong>
                    <t t-esc="doc.assessment_date_display"/> <t t-esc="doc.assessment_time_display"/></td>
                <td><strong>COP:</strong> <t t-esc="doc.cop_no"/></td>
                <td><strong>DOP:</strong> <t t-esc="doc.dop_no"/></td>
                <td><strong>Consultant:</strong> <t t-esc="doc.doctor_id.display_name or ''"/></td>
            </tr>
        </table>

        <table class="table table-bordered table-sm">
            <tr><th colspan="2" class="text-center">Observations</th></tr>
            <tr><td>BP</td><td><t t-esc="doc.bp"/></td></tr>
            <tr><td>PR</td><td><t t-esc="doc.pr"/></td></tr>
            <tr><td>Naadi</td><td><t t-esc="doc.naadi"/></td></tr>
        </table>

        <table class="table table-bordered table-sm">
            <thead>
                <tr>
                    <th colspan="7" class="text-center">
                        Medication with Route | Dose | Time | Duration | Anupana | Pathya-Apathya
                    </th>
                </tr>
                <tr>
                    <th>Medicine</th><th>Route</th><th>Dose</th><th>Time</th>
                    <th>Duration</th><th>Anupana</th><th>Pathya-Apathya</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="doc.prescription_ids" t-as="line">
                    <tr>
                        <td><t t-esc="line.medicine_id.name"/></td>
                        <td><t t-esc="line.route"/></td>
                        <td><t t-esc="line.no_intakes"/></td>
                        <td><t t-esc="line.time"/></td>
                        <td><t t-esc="line.duration_days"/> days</td>
                        <td><t t-esc="line.anupanam"/></td>
                        <td><t t-esc="line.pathya_apathya"/></td>
                    </tr>
                </t>
            </tbody>
        </table>

        <table class="table table-borderless table-sm mt-4">
            <tr>
                <td colspan="2"><strong>Name and signature of the Consultant:</strong>
                    <t t-esc="doc.consultant_signoff_id.name or ''"/></td>
            </tr>
            <tr>
                <td><strong>Date:</strong> <t t-esc="doc.signoff_date"/></td>
                <td><strong>Time:</strong> <t t-esc="doc.signoff_time"/></td>
            </tr>
        </table>
    </template>

    <template id="report_op_reassessment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <t t-call="santhigiri_hms.report_op_reassessment_slip"/>
                        <hr style="border-top: 1px dashed #999; margin: 20px 0;"/>
                        <t t-call="santhigiri_hms.report_op_reassessment_slip"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>