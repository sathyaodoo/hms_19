<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend hr.employee form to show Santhigiri-specific role flags -->
    <record id="view_employee_form_santhigiri" model="ir.ui.view">
        <field name="name">hr.employee.form.santhigiri.roles</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="base_hospital_management.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Add role flags after doctor consultancy fields -->
            <xpath expr="//field[@name='consultancy_type']" position="after">
                <separator string="Santhigiri Roles"/>
                <field name="doctor" string="Is Doctor (Prescribed By dropdown)"/>
                <field name="is_rmo"/>
                <field name="is_therapist"/>
                <field name="is_dietitian"/>
                <field name="is_intern"/>
            </xpath>
        </field>
    </record>
</odoo>