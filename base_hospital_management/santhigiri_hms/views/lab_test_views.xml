<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_patient_lab_test_santhigiri" model="ir.ui.view">
        <field name="name">patient.lab.test.form.santhigiri</field>
        <field name="model">patient.lab.test</field>
        <field name="inherit_id" ref="base_hospital_management.patient_lab_test_view_form"/>
        <field name="arch" type="xml">

            <!-- Add Priority after date field -->
            <xpath expr="//field[@name='date']" position="after">
                <field name="priority" widget="priority" string="Priority"/>
            </xpath>

            <!-- Add Clinical Notes + External Lab as new page in notebook -->
            <xpath expr="//page[@name='Result']" position="before">
                <page string="Clinical Notes &amp; External Lab" name="clinical_ext">
                    <group string="Clinical Notes">
                        <field name="clinical_notes"
                               nolabel="1"
                               colspan="2"
                               placeholder="Doctor's clinical notes for the lab technician..."/>
                    </group>
                    <group string="External Lab">
                        <field name="is_external" string="Send to External Lab"/>
                        <field name="external_lab_name"
                               invisible="not is_external"
                               required="is_external"/>
                        <field name="external_ref_no"
                               invisible="not is_external"/>
                        <field name="external_charge"
                               invisible="not is_external"
                               widget="monetary"/>
                    </group>
                </page>
            </xpath>

            <!-- Add is_abnormal column after uom_id in Result tab -->
            <xpath expr="//field[@name='result_ids']/list/field[@name='uom_id']"
                   position="after">
                <field name="is_abnormal"
                       string="Abnormal"
                       readonly="1"
                       decoration-danger="is_abnormal == True"/>
            </xpath>

            <!-- Import from Equipment button before End Test -->
            <xpath expr="//button[@name='action_test_end']" position="before">
                <button name="action_import_from_equipment"
                        type="object"
                        string="Import from Equipment"
                        class="btn btn-info"
                        icon="fa-download"
                        invisible="state != 'test'"/>
            </xpath>

        </field>
    </record>

    <!-- lab.test.LINE list view — priority color coding (this is what Lab Tests shows) -->
    <record id="view_lab_test_line_list_santhigiri" model="ir.ui.view">
        <field name="name">lab.test.line.list.santhigiri</field>
        <field name="model">lab.test.line</field>
        <field name="inherit_id" ref="base_hospital_management.lab_test_line_view_tree"/>
        <field name="arch" type="xml">
            <!-- Add priority column -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="priority" widget="priority" string="Priority"/>
            </xpath>
            <!-- Color rows by priority -->
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">priority == 'stat'</attribute>
                <attribute name="decoration-warning">priority == 'urgent'</attribute>
            </xpath>
        </field>
    </record>

    <!-- lab.test master — add default normal range and unit -->
    <record id="view_lab_test_master_santhigiri" model="ir.ui.view">
        <field name="name">lab.test.master.santhigiri</field>
        <field name="model">lab.test</field>
        <field name="inherit_id" ref="base_hospital_management.lab_test_view_form"/>
        <field name="arch" type="xml">
            <!-- Add default normal range after test name -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="default_normal_range"
                       string="Default Normal Range"
                       placeholder="e.g. 12.0 - 17.0 or Negative or &lt;5.0"/>
                <field name="default_uom_id"
                       string="Default Unit (g/dL, mg/dL, etc.)"/>
            </xpath>
        </field>
    </record>

    <!-- lab.test.line form — add priority and clinical notes (FRD §17.1) -->
    <record id="view_lab_test_line_santhigiri" model="ir.ui.view">
        <field name="name">lab.test.line.form.santhigiri</field>
        <field name="model">lab.test.line</field>
        <field name="inherit_id" ref="base_hospital_management.lab_test_line_view_form"/>
        <field name="arch" type="xml">
            <!-- Add priority and clinical notes after patient_type -->
            <xpath expr="//field[@name='patient_type']" position="after">
                <field name="priority" widget="priority" string="Priority"/>
                <field name="clinical_notes"
                       string="Clinical Notes (for Lab Tech)"
                       placeholder="Doctor's instructions for the lab technician..."/>
            </xpath>
        </field>
    </record>

    <!-- Override Create Invoice button to add more groups -->
    <record id="view_lab_test_invoice_btn_santhigiri" model="ir.ui.view">
        <field name="name">patient.lab.test.invoice.btn.santhigiri</field>
        <field name="model">patient.lab.test</field>
        <field name="inherit_id" ref="base_hospital_management.patient_lab_test_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_create_invoice']" position="attributes">
                <attribute name="groups">base_hospital_management.base_hospital_management_group_lab_assistant,base_hospital_management.base_hospital_management_group_manager,base_hospital_management.base_hospital_management_group_doctor,santhigiri_hms.group_rmo</attribute>
            </xpath>
        </field>
    </record>
</odoo>