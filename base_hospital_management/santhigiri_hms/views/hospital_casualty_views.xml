<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Casualty Registration Form -->
    <record id="view_casualty_form" model="ir.ui.view">
        <field name="name">hospital.casualty.form</field>
        <field name="model">hospital.casualty</field>
        <field name="arch" type="xml">
            <form string="Casualty Registration">
                <header>
                    <button name="action_treat_and_discharge" type="object"
                            string="Treat &amp; Discharge" class="btn btn-success"
                            invisible="state not in ['registered','under_treatment','observation']"/>
                    <button name="action_under_observation" type="object"
                            string="Under Observation" class="btn btn-warning"
                            invisible="state not in ['registered','under_treatment']"/>
                    <button name="action_admit_inpatient" type="object"
                            string="Admit to IP" class="btn btn-danger"
                            invisible="state not in ['registered','under_treatment','observation']"/>
                    <button name="action_referral" type="object"
                            string="Referral" class="btn btn-secondary"
                            invisible="state not in ['registered','under_treatment','observation']"/>
                    <button name="action_print_referral_letter" type="object"
                            string="Print Referral Letter"
                            invisible="outcome != 'referral'"/>
                    <button name="action_create_invoice" type="object"
                            string="Create Invoice"
                            class="btn btn-warning"
                            icon="fa-file-text-o"
                            invisible="invoice_id != False"
                            confirm="Create a billing invoice for this casualty case?"/>
                    <button name="action_view_invoice" type="object"
                            string="View Invoice"
                            class="btn btn-info"
                            icon="fa-eye"
                            invisible="invoice_id == False"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="registered,under_treatment,observation,discharged"/>
                </header>

                <!-- Allergy Alert Banner -->
                <div class="alert alert-danger" invisible="not has_allergy">
                    <strong>&#9888; ALLERGY ALERT: </strong>
                    <field name="allergy_summary" readonly="1"/>
                </div>

                <sheet>
                    <div class="oe_title">
                        <h1><field name="casualty_reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Patient">
                            <field name="patient_id"/>
                            <field name="patient_seq" readonly="1"/>
                            <field name="blood_group" readonly="1"/>
                            <field name="registration_datetime"/>
                            <field name="token_no" readonly="1"/>
                        </group>
                        <group string="RMO &amp; Assignment">
                            <field name="rmo_id"/>
                            <field name="referred_by"/>
                            <field name="intern_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Chief Complaint">
                            <field name="chief_complaint" nolabel="1"
                                   placeholder="Enter chief complaint"
                                   widget="text"/>
                        </page>

                        <page string="Vitals">
                            <group>
                                <group>
                                    <field name="bp"/>
                                    <field name="pulse"/>
                                    <field name="temperature"/>
                                </group>
                                <group>
                                    <field name="spo2"/>
                                    <field name="respiratory_rate"/>
                                </group>
                            </group>
                        </page>

                        <page string="Clinical Assessment">
                            <group>
                                <field name="clinical_history" nolabel="1"
                                       placeholder="Clinical History"
                                       widget="text" colspan="2"/>
                                <field name="examination_findings" nolabel="1"
                                       placeholder="Examination Findings"
                                       widget="text" colspan="2"/>
                                <field name="provisional_diagnosis" nolabel="1"
                                       placeholder="Provisional Diagnosis"
                                       widget="text" colspan="2"/>
                                <field name="special_instructions" nolabel="1"
                                       placeholder="Special Instructions"
                                       widget="text" colspan="2"/>
                            </group>
                        </page>

                        <page string="Medicines Prescribed">
                            <field name="prescription_ids">
                                <list editable="bottom">
                                    <field name="medicine_id"/>
                                    <field name="quantity"/>
                                    <field name="no_intakes"/>
                                    <field name="time"/>
                                    <field name="note"/>
                                    <field name="anupanam"/>
                                    <field name="route"/>
                                </list>
                            </field>
                        </page>

                        <page string="Referral Details" name="referral_details">
                            <group>
                                <field name="referral_hospital"/>
                                <field name="referral_reason" widget="text"/>
                                <field name="ambulance_no"/>
                                <field name="accompanying_staff_id"/>
                                <field name="departure_datetime"/>
                            </group>
                        </page>

                        <page string="Billing">
                            <group>
                                <field name="casualty_fee" widget="monetary"/>
                                <field name="invoice_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Casualty List View -->
    <record id="view_casualty_list" model="ir.ui.view">
        <field name="name">hospital.casualty.list</field>
        <field name="model">hospital.casualty</field>
        <field name="arch" type="xml">
            <list string="Casualty Registrations"
                  decoration-danger="has_allergy == True"
                  decoration-warning="state == 'observation'">
                <field name="casualty_reference"/>
                <field name="registration_datetime"/>
                <field name="patient_id"/>
                <field name="chief_complaint"/>
                <field name="rmo_id"/>
                <field name="outcome" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="has_allergy" optional="hide" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Duty Roster List View -->
    <record id="view_duty_roster_list" model="ir.ui.view">
        <field name="name">casualty.duty.roster.list</field>
        <field name="model">casualty.duty.roster</field>
        <field name="arch" type="xml">
            <list string="Intern Casualty Duty Roster">
                <field name="duty_date"/>
                <field name="session"/>
                <field name="intern_ids" widget="many2many_tags"/>
                <field name="assigned_by"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Duty Roster Form View -->
    <record id="view_duty_roster_form" model="ir.ui.view">
        <field name="name">casualty.duty.roster.form</field>
        <field name="model">casualty.duty.roster</field>
        <field name="arch" type="xml">
            <form string="Intern Casualty Duty Roster">
                <header>
                    <button name="action_publish" type="object"
                            string="Publish &amp; Notify"
                            class="btn btn-primary"
                            invisible="state == 'published'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="duty_date"/>
                        <field name="session"/>
                        <field name="intern_ids" widget="many2many_tags"/>
                        <field name="assigned_by"/>
                        <field name="notes" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>