<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_hospital_casualty" model="ir.sequence">
            <field name="name">Hospital Casualty Reference</field>
            <field name="code">hospital.casualty</field>
            <field name="prefix">CAS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_casualty_token" model="ir.sequence">
            <field name="name">Casualty Token Number</field>
            <field name="code">casualty.token</field>
            <field name="prefix">CT</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_procedure_prescription" model="ir.sequence">
            <field name="name">Procedure Prescription Reference</field>
            <field name="code">hospital.procedure.prescription</field>
            <field name="prefix">PROC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_bystander_pass" model="ir.sequence">
            <field name="name">Bystander Pass Number</field>
            <field name="code">bystander.pass</field>
            <field name="prefix">BP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_hospital_intern" model="ir.sequence">
            <field name="name">Hospital Intern ID</field>
            <field name="code">hospital.intern</field>
            <field name="prefix">INT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
