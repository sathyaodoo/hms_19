<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Override base module's Booking menu to point to our OTP portal -->
        <record id="base_hospital_management.website_menu_patient_booking"
                model="website.menu">
            <field name="name">Book Appointment</field>
            <field name="url">/santhigiri/book</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">50</field>
        </record>
        <!-- Patient Portal (separate from booking) -->
        <record id="website_menu_patient_portal" model="website.menu">
            <field name="name">Patient Portal</field>
            <field name="url">/patient</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">51</field>
        </record>
    </data>
</odoo>