<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: values changed by the hospital survive module upgrades -->
    <data noupdate="1">
        <!-- TEST MODE: when True, the login code is written to the server
             log and shown on the verify page. MUST be False in production
             once an SMS gateway / e-mail server is configured. -->
        <record id="param_portal_otp_debug" model="ir.config_parameter">
            <field name="key">santhigiri_hms.portal_otp_debug</field>
            <field name="value">False</field>
        </record>
        <!-- Send the code with Odoo's own SMS app (module "sms", IAP credits) -->
        <record id="param_portal_otp_use_odoo_sms" model="ir.config_parameter">
            <field name="key">santhigiri_hms.portal_otp_use_odoo_sms</field>
            <field name="value">False</field>
        </record>
        <!-- FIRST login with Patient ID as login AND as password (one time
             only; the patient must then create his own password).
             Convenient, but anybody who knows / sees a Patient ID can use
             it until that patient has set a password. Default: off. -->
        <record id="param_portal_first_login_with_patient_id" model="ir.config_parameter">
            <field name="key">santhigiri_hms.portal_first_login_with_patient_id</field>
            <field name="value">False</field>
        </record>
        <!-- Log the patient out after this many idle minutes -->
        <record id="param_portal_session_timeout" model="ir.config_parameter">
            <field name="key">santhigiri_hms.portal_session_timeout_minutes</field>
            <field name="value">30</field>
        </record>
        <!-- How many days ahead a patient may book -->
        <record id="param_portal_booking_days" model="ir.config_parameter">
            <field name="key">santhigiri_hms.portal_booking_days</field>
            <field name="value">7</field>
        </record>

        <record id="cron_purge_portal_otp" model="ir.cron">
            <field name="name">HMS: Purge old Patient Portal login codes</field>
            <field name="model_id" ref="model_santhigiri_patient_portal_otp"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_old_codes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>