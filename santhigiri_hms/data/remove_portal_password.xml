<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The "Portal Password" button and its wizard were removed.
         Delete the old views from databases that already have them, BEFORE
         the patient form views are loaded; otherwise the upgrade fails with
         "action_open_portal_password_wizard is not a valid action on
         res.partner". On a fresh install these records do not exist and
         the deletes are simply skipped. -->
    <data noupdate="0">
        <delete model="ir.ui.view" search="[('name', '=', 'res.partner.patient.portal.button'), ('model', '=', 'res.partner')]"/>
        <delete model="ir.ui.view" search="[('model', '=', 'santhigiri.patient.portal.password.wizard')]"/>
    </data>
</odoo>