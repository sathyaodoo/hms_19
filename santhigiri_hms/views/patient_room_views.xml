<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend patient.room form — add Mark Clean button to EXISTING header -->
    <record id="view_patient_room_form_santhigiri" model="ir.ui.view">
        <field name="name">patient.room.form.santhigiri</field>
        <field name="model">patient.room</field>
        <field name="inherit_id" ref="base_hospital_management.patient_room_view_form"/>
        <field name="arch" type="xml">

            <!-- Add Mark Clean button INSIDE existing header, before state field -->
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_mark_clean_ready"
                        type="object"
                        string="✓ Mark Clean and Ready"
                        class="btn btn-success"
                        invisible="state != 'cleaning'"
                        confirm="Mark this room as cleaned and available for new admissions?"/>
            </xpath>

            <!-- Add housekeeping info after Facilities section -->
            <xpath expr="//field[@name='room_facilities_ids']" position="after">
                <separator string="Housekeeping"/>
                <group invisible="state == 'avail'">
                    <field name="housekeeping_notes" string="Cleaning Notes"/>
                    <field name="last_cleaned_by" string="Last Cleaned By" readonly="1"/>
                    <field name="last_cleaned_date" string="Last Cleaned On" readonly="1"/>
                </group>
            </xpath>

        </field>
    </record>

    <!-- Extend room list with color coding -->
    <record id="view_patient_room_list_santhigiri" model="ir.ui.view">
        <field name="name">patient.room.list.santhigiri</field>
        <field name="model">patient.room</field>
        <field name="inherit_id" ref="base_hospital_management.patient_room_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-warning">state == 'cleaning'</attribute>
                <attribute name="decoration-success">state == 'avail'</attribute>
                <attribute name="decoration-danger">state == 'not'</attribute>
            </xpath>
        </field>
    </record>
</odoo>