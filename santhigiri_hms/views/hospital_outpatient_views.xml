<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- OP form extension -->
    <record id="view_outpatient_form_santhigiri" model="ir.ui.view">
        <field name="name">hospital.outpatient.form.santhigiri</field>
        <field name="model">hospital.outpatient</field>
        <field name="inherit_id" ref="base_hospital_management.hospital_outpatient_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='reason']" position="after">
                <field name="patient_category" widget="selection"/>
                <field name="category_fee" widget="monetary" readonly="1"
                       string="Consultation Fee (Auto)"/>
                <field name="camp_id" string="Medical Camp (if applicable)"
                       domain="[('state','=','active')]"
                       options="{'no_create': true}"/>
                <!-- §9.5 Referral -->
                <field name="is_referred" string="Referred Patient"/>
            </xpath>

            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="action_outcome_regular" type="object"
                        string="Regular OP Done" class="btn btn-success"
                        invisible="state not in ['op']"
                        icon="fa-check-circle"/>
                <button name="action_outcome_procedures" type="object"
                        string="OP + Daily Procedures" class="btn btn-warning"
                        invisible="state not in ['op']"
                        icon="fa-clock-o"/>
                <button name="action_outcome_inpatient" type="object"
                        string="Admit to IP" class="btn btn-danger"
                        invisible="state not in ['op']"
                        icon="fa-hospital-o"/>
            </xpath>

            <!-- ★ NEW: Route / Anupana / Duration columns in the Prescription tab list ★ -->
            <xpath expr="//field[@name='prescription_ids']/list/field[@name='medicine_id']"
                   position="after">
                <field name="route"/>
            </xpath>
            <xpath expr="//field[@name='prescription_ids']/list/field[@name='quantity']"
                   position="after">
                <field name="anupanam"/>
                <field name="duration_days"/>
            </xpath>

            <xpath expr="//page[@name='Prescription']" position="after">
                <page string="Case Sheet" name="case_sheet">
                    <group>
                        <group string="Clinical Notes">
                            <field name="chief_complaint" nolabel="1"
                                   placeholder="Chief Complaint"
                                   widget="text" colspan="2"/>
                        </group>
                        <group string="Examination">
                            <field name="examination_findings" nolabel="1"
                                   placeholder="Examination Findings"
                                   widget="text" colspan="2"/>
                        </group>
                        <group string="Diagnosis &amp; Plan">
                            <field name="provisional_diagnosis" nolabel="1"
                                   placeholder="Provisional Diagnosis"
                                   widget="text" colspan="2"/>
                            <field name="treatment_notes" nolabel="1"
                                   placeholder="Treatment Notes / Plan"
                                   widget="text" colspan="2"/>
                        </group>
                        <group string="Follow-Up">
                            <field name="followup_date"/>
                            <field name="followup_notes"/>
                        </group>
                    </group>
                </page>

                <!-- §9.5 Referral Details tab -->
                <page string="Referral Details" name="referral_tab"
                      invisible="not is_referred">
                    <group>
                        <group string="Referring Source">
                            <field name="referred_by" string="Referred By (Doctor Name)"/>
                            <field name="referring_hospital" string="Referring Hospital / Clinic"/>
                            <field name="referral_date" string="Referral Date"/>
                        </group>
                        <group string="Reason">
                            <field name="referral_reason" string="Reason for Referral"
                                   nolabel="1" colspan="2" widget="text"
                                   placeholder="Reason for referral..."/>
                        </group>
                    </group>
                    <separator string="Referral Letter / Documents"/>
                    <field name="referral_document_ids"
                           string="Referral Documents"
                           widget="many2many_binary"
                           nolabel="1"/>
                </page>

                <page string="Procedures" name="procedures"
                      invisible="outcome != 'procedure'">
                    <field name="procedure_prescription_ids">
                        <list>
                            <field name="reference"/>
                            <field name="procedure_id"/>
                            <field name="no_of_sessions"/>
                            <field name="start_date"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>

                <page string="Observing Interns" name="interns">
                    <field name="observer_intern_ids" widget="many2many_tags"/>
                </page>
            </xpath>

            <!-- Add Doctor + RMO to Create Lab Test button -->
            <xpath expr="//button[@name='action_create_lab_test']" position="attributes">
                <attribute name="groups">base_hospital_management.base_hospital_management_group_manager,base_hospital_management.base_hospital_management_group_doctor,base_hospital_management.base_hospital_management_group_receptionist,base_hospital_management.base_hospital_management_group_lab_assistant,base_hospital_management.base_hospital_management_group_nurse,santhigiri_hms.group_rmo</attribute>
            </xpath>

        </field>
    </record>

    <!-- Fee Master Views -->
    <record id="view_fee_master_list" model="ir.ui.view">
        <field name="name">hospital.fee.master.list</field>
        <field name="model">hospital.fee.master</field>
        <field name="arch" type="xml">
            <list string="Consultation Fee Master" editable="bottom">
                <field name="patient_category"/>
                <field name="department_id"/>
                <field name="amount" widget="monetary"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fee_master_form" model="ir.ui.view">
        <field name="name">hospital.fee.master.form</field>
        <field name="model">hospital.fee.master</field>
        <field name="arch" type="xml">
            <form string="Consultation Fee">
                <sheet>
                    <group>
                        <field name="patient_category"/>
                        <field name="department_id"/>
                        <field name="amount" widget="monetary"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>