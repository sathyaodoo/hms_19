<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- EMR Timeline List View -->
    <record id="view_emr_timeline_list" model="ir.ui.view">
        <field name="name">patient.emr.timeline.list</field>
        <field name="model">patient.emr.timeline</field>
        <field name="arch" type="xml">
            <list string="EMR Timeline"
                  create="false" edit="false" delete="false"
                  decoration-danger="is_abnormal == True"
                  decoration-info="event_type == 'op'"
                  decoration-success="event_type == 'procedure'"
                  decoration-warning="event_type == 'casualty'">
                <field name="date"/>
                <field name="event_type" string="Type" widget="badge"/>
                <field name="summary" string="Summary"/>
                <field name="doctor_id" string="Doctor / RMO"/>
                <field name="notes" string="Details / Notes"/>
                <field name="is_abnormal" string="⚠" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_emr_timeline" model="ir.actions.act_window">
        <field name="name">EMR Timeline</field>
        <field name="res_model">patient.emr.timeline</field>
        <field name="view_mode">list</field>
        <field name="context">{'create': False}</field>
    </record>

    <!-- Add EMR smart button to patient form -->
    <record id="view_partner_emr_button" model="ir.ui.view">
        <field name="name">res.partner.emr.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_emr" type="object"
                        class="oe_stat_button"
                        icon="fa-file-medical"
                        invisible="not patient_seq or patient_seq in ('New','Employee','User')"
                        groups="base_hospital_management.base_hospital_management_group_doctor,base_hospital_management.base_hospital_management_group_manager,base_hospital_management.base_hospital_management_group_nurse,santhigiri_hms.group_rmo">
                    <field name="emr_count" widget="statinfo" string="EMR"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>