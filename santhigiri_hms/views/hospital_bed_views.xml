<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend hospital.bed form — add Mark Clean button to EXISTING
         header, same pattern as view_patient_room_form_santhigiri -->
    <record id="view_hospital_bed_form_santhigiri" model="ir.ui.view">
        <field name="name">hospital.bed.form.santhigiri</field>
        <field name="model">hospital.bed</field>
        <field name="inherit_id" ref="base_hospital_management.hospital_bed_view_form"/>
        <field name="arch" type="xml">

            <!-- Add Mark Clean button INSIDE existing header, before
                 the state field -->
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_mark_clean_ready"
                        type="object"
                        string="✓ Mark Clean and Ready"
                        class="btn btn-success"
                        invisible="state != 'cleaning'"
                        confirm="Mark this bed as cleaned and available for new admissions?"/>
            </xpath>

            <!-- Add housekeeping info after the existing bed fields
                 group (targets the outer <group> that wraps the two
                 field columns), before the footer -->
            <xpath expr="//field[@name='ward_id']/ancestor::group[2]" position="after">
                <separator string="Housekeeping"/>
                <group invisible="state == 'avail'">
                    <field name="housekeeping_notes" string="Cleaning Notes"/>
                    <field name="last_cleaned_by" string="Last Cleaned By" readonly="1"/>
                    <field name="last_cleaned_date" string="Last Cleaned On" readonly="1"/>
                </group>
            </xpath>

        </field>
    </record>

    <!-- Extend bed list with the same colour coding used on the room
         list -->
    <record id="view_hospital_bed_list_santhigiri" model="ir.ui.view">
        <field name="name">hospital.bed.list.santhigiri</field>
        <field name="model">hospital.bed</field>
        <field name="inherit_id" ref="base_hospital_management.hospital_bed_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-warning">state == 'cleaning'</attribute>
                <attribute name="decoration-success">state == 'avail'</attribute>
                <attribute name="decoration-info">state == 'reserve'</attribute>
                <attribute name="decoration-danger">state == 'not'</attribute>
            </xpath>
        </field>
    </record>
</odoo>