<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inpatient_form_santhigiri" model="ir.ui.view">
        <field name="name">hospital.inpatient.form.santhigiri</field>
        <field name="model">hospital.inpatient</field>
        <field name="inherit_id" ref="base_hospital_management.hospital_inpatient_view_form"/>
        <field name="arch" type="xml">

            <!-- Initial Assessment & Procedure Schedule Stat Buttons in button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_assessment" type="object"
                        class="oe_stat_button" icon="fa-stethoscope">
                    <field name="assessment_count" widget="statinfo" string="Initial Assessment"/>
                </button>
                <button name="action_open_procedure_schedule" type="object"
                        class="oe_stat_button" icon="fa-calendar-check-o">
                    <field name="procedure_schedule_count" widget="statinfo" string="Procedure Schedule"/>
                </button>
            </xpath>

            <!-- 1. Add patient_category, uhid_no, department_id, review_date right after patient_id -->
            <xpath expr="//field[@name='patient_id']" position="after">
                <field name="uhid_no" readonly="1"/>
                <field name="patient_category"
                       required="1"
                       string="IP Category"/>
                <field name="department_id" readonly="1"/>
                <field name="source_op_id" readonly="1" invisible="not source_op_id"/>
                <field name="review_date" string="Review Date"/>
            </xpath>

            <!-- Add ot_charge after operating_doctor_id -->
            <xpath expr="//field[@name='operating_doctor_id']" position="after">
                <field name="ot_charge" widget="monetary" string="OT / Surgical Charges"/>
            </xpath>

            <!-- 2. Add nurse + diet after type_admission -->
            <xpath expr="//field[@name='type_admission']" position="after">
                <field name="assigned_nurse_id" string="Assigned Nurse"/>
                <field name="diet_plan_id" string="Diet Plan"/>
            </xpath>

            <!-- 3. Add advance fields after reason -->
            <xpath expr="//field[@name='reason']" position="after">
                <field name="advance_percent" string="Advance %"/>
                <field name="advance_amount" widget="monetary" string="Advance Collected"/>
            </xpath>

            <!-- 4. Add is_ward (Accommodation Type) in the right group
                 next to type_admission — keeps it in 2-column layout -->
            <xpath expr="//field[@name='enable_outpatient']" position="after">
                <field name="is_ward" string="Accommodation Type"/>
                <field name="bed_id"
                       string="Bed"
                       options="{&quot;no_create&quot;: true}"
                       invisible="is_ward != 'ward'"/>
                <field name="ward_id"
                       string="Ward"
                       options="{&quot;no_create&quot;: true}"
                       invisible="is_ward != 'ward'"/>
                <field name="room_id"
                       string="Room"
                       options="{&quot;no_create&quot;: true}"
                       invisible="is_ward != 'room'"/>
                <field name="bed_rent"
                       string="Bed Rent / Day"
                       invisible="is_ward != 'ward'"/>
                <field name="room_rent"
                       string="Room Rent / Day"
                       invisible="is_ward != 'room'"/>
            </xpath>

            <!-- 5. Bystander Pass + Service Charge after bed_rent_amount -->
            <xpath expr="//field[@name='bed_rent_amount']" position="after">
                <field name="service_charge" widget="monetary" string="Service Charges"/>
                <separator string="Bystander Pass"/>
                <field name="bystander_name" string="Bystander Name"/>
                <field name="bystander_relation" string="Relation to Patient"/>
                <field name="bystander_pass_no" readonly="1" string="Pass No."/>
                <button name="action_generate_bystander_pass" type="object"
                        string="Generate &amp; Print Bystander Pass"
                        invisible="not bystander_name"/>
            </xpath>

            <!-- 6. New tabs after Nursing Plan -->
            <xpath expr="//page[@name='Nursing Plan']" position="after">
                <page string="Treatment Plan (Procedures)" name="treatment_plan">
                    <!-- Top header with link to full schedule -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-primary m-0">
                            <i class="fa fa-bed me-2"/>TREATMENT PLAN &amp; PROCEDURE SCHEDULE
                        </h5>
                        <button name="action_open_procedure_schedule" type="object"
                                string="Open Case Sheet (Procedure Schedule)"
                                class="btn btn-outline-primary btn-sm"
                                icon="fa-calendar-check-o"/>
                    </div>

                    <!-- Quick Schedule Procedure Session (Native Full-Width Odoo Groups) -->
                    <group string="Schedule Procedure Session" class="mt-2">
                        <group string="Timing &amp; Procedure">
                            <field name="quick_proc_date" string="Date"/>
                            <label for="quick_proc_start_time" string="Time Slot"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="quick_proc_start_time" placeholder="Start Time" class="w-50"/>
                                <span class="text-muted fw-bold">to</span>
                                <field name="quick_proc_end_time" placeholder="End Time" class="w-50"/>
                            </div>
                            <field name="quick_proc_duration" string="Duration" placeholder="e.g. 45m"/>
                            <field name="quick_proc_procedure_id" string="Procedure"
                                   context="{'default_is_procedure': True, 'default_type': 'service'}"
                                   options="{'no_create': False, 'no_quick_create': False}"
                                   placeholder="Select Procedure..."/>
                        </group>
                        <group string="Room, Staff &amp; Location">
                            <field name="quick_proc_room_id" string="Treatment Room" options="{'no_create': True}" placeholder="Select Room..."/>
                            <field name="quick_proc_staff_ids" widget="many2many_tags" string="Staff / Therapists" placeholder="Choose Staff..."/>
                            <field name="quick_proc_location" string="Location / Site" placeholder="e.g. All joints, Head, Back..."/>
                            <field name="quick_proc_notes" string="Clinical Notes" placeholder="e.g. E/A-HRIDAYARENJINI or instructions..."/>
                        </group>
                    </group>

                    <group string="Medicines &amp; Consumables (Used in Session)">
                        <group>
                            <label for="quick_proc_med_1" string="Medicine 1"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="quick_proc_med_1"
                                       context="{'default_medicine_ok': True, 'default_type': 'consu'}"
                                       options="{'no_create': False, 'no_quick_create': False}"
                                       placeholder="Medicine 1..." style="flex: 2;"/>
                                <field name="quick_proc_dose_1" placeholder="Dose (e.g. 10)" style="flex: 1;"/>
                                <field name="quick_proc_unit_1" placeholder="Unit (ml)" style="flex: 1;"/>
                            </div>
                            <label for="quick_proc_med_2" string="Medicine 2"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="quick_proc_med_2"
                                       context="{'default_medicine_ok': True, 'default_type': 'consu'}"
                                       options="{'no_create': False, 'no_quick_create': False}"
                                       placeholder="Medicine 2..." style="flex: 2;"/>
                                <field name="quick_proc_dose_2" placeholder="Dose" style="flex: 1;"/>
                                <field name="quick_proc_unit_2" placeholder="Unit" style="flex: 1;"/>
                            </div>
                            <label for="quick_proc_med_3" string="Medicine 3"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="quick_proc_med_3"
                                       context="{'default_medicine_ok': True, 'default_type': 'consu'}"
                                       options="{'no_create': False, 'no_quick_create': False}"
                                       placeholder="Medicine 3..." style="flex: 2;"/>
                                <field name="quick_proc_dose_3" placeholder="Dose" style="flex: 1;"/>
                                <field name="quick_proc_unit_3" placeholder="Unit" style="flex: 1;"/>
                            </div>
                        </group>
                        <group>
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 p-3 bg-light rounded border text-center">
                                <p class="text-muted small mb-3">
                                    Fill the session details above and click below to add this procedure session to the Treatment Plan &amp; Schedule.
                                </p>
                                <button name="action_quick_add_procedure" type="object"
                                        string="+ Add to Schedule / Plan"
                                        class="btn btn-primary btn-lg fw-bold px-4 py-2"/>
                            </div>
                        </group>
                    </group>

                    <!-- Scheduled Procedure Sessions Table (Identical format to Procedure Schedule) -->
                    <field name="treatment_plan_ids" class="mt-3">
                        <list editable="bottom" create="1" delete="1"
                              decoration-info="status == 'updated'"
                              decoration-success="status == 'done'"
                              decoration-warning="status == 'in_progress'"
                              decoration-muted="status == 'cancelled'">
                            <field name="date" string="Date"/>
                            <field name="start_time" string="Start Time"/>
                            <field name="end_time" string="End Time"/>
                            <field name="procedure_id" string="Procedure"
                                   context="{'default_is_procedure': True, 'default_type': 'service'}"
                                   options="{'no_create': False, 'no_quick_create': False}"/>
                            <field name="medicine_display" string="Medicine" readonly="1"/>
                            <field name="duration" string="Duration"/>
                            <field name="location_site" string="Location / Site"/>
                            <field name="notes" string="Notes"/>
                            <field name="treatment_room_id" string="Treatment Room" options="{'no_create': True}"/>
                            <field name="staff_display" string="Staff" readonly="1"/>
                            <field name="status" string="Status" widget="badge"
                                   decoration-info="status == 'updated'"
                                   decoration-success="status == 'done'"
                                   decoration-warning="status == 'in_progress'"
                                   decoration-muted="status == 'scheduled'"/>
                            <button name="action_repeat" type="object" string="Repeat"
                                    class="btn btn-sm btn-outline-secondary py-0 px-2"
                                    title="Repeat this session on the next day"/>
                            <button name="action_delete" type="object" string="Delete"
                                    class="btn btn-sm btn-outline-danger py-0 px-2"
                                    title="Delete this scheduled session"/>
                        </list>
                    </field>
                </page>

                <page string="Medication Plan (Medicines)" name="medication_plan">
                    <button name="action_dispense_ip_medicines"
                            type="object"
                            string="💊 Send to Pharmacy"
                            class="btn btn-primary mb-2"
                            groups="base_hospital_management.base_hospital_management_group_doctor,base_hospital_management.base_hospital_management_group_manager,santhigiri_hms.group_rmo"
                            confirm="Send all Medication Plan medicines to the IP Pharmacy for dispensing?"/>
                    <field name="medication_plan_ids">
                        <list editable="bottom">
                            <field name="medicine_id" string="Medicine"
                                   context="{'default_medicine_ok': True, 'default_type': 'consu'}"
                                   options="{'no_create': False, 'no_quick_create': False}"/>
                            <field name="dosage"/>
                            <field name="frequency"/>
                            <field name="duration_days" string="Days"/>
                            <field name="anupanam"/>
                            <field name="route"/>
                            <field name="total_charge" widget="monetary" string="Charge"/>
                        </list>
                    </field>
                </page>

                <page string="Food &amp; Diet" name="food_diet">
                    <group>
                        <field name="diet_plan_id" string="Diet Plan"/>
                        <field name="food_charges_total" widget="monetary"
                               readonly="1" string="Total Food Charges"/>
                    </group>
                    <separator string="Daily Food Supply"/>
                    <field name="food_supply_ids">
                        <list editable="bottom">
                            <field name="supply_date" string="Date"/>
                            <field name="meal_type" string="Meal"/>
                            <field name="diet_plan_id" string="Diet Plan"/>
                            <field name="additional_items" string="Additional Items"/>
                            <field name="charge" widget="monetary" string="Charge"/>
                            <field name="bystander_meal" string="Bystander Meal"/>
                        </list>
                    </field>
                </page>

                <page string="Consent &amp; Follow-Up" name="consent">
                    <group string="Consent Forms (Upload signed documents)">
                        <div class="alert alert-info" style="margin-bottom:10px;">
                            <strong>How to upload:</strong>
                            Print consent form → Get patient/family signature →
                            Scan → Click upload below.
                        </div>
                        <field name="consent_form_ids"
                               widget="many2many_binary"
                               string="Signed Consent Forms"
                               nolabel="1"
                               colspan="2"/>
                    </group>
                    <separator string="Follow-Up Appointments"/>
                    <field name="followup_ids">
                        <list>
                            <field name="followup_date" string="Date"/>
                            <field name="reason" string="Instructions"/>
                            <field name="status" widget="badge"/>
                        </list>
                    </field>
                </page>
                                <page string="Observing Interns" name="ip_interns">
                    <field name="observer_intern_ids" widget="many2many_tags"
                           domain="[('state','=','active')]"
                           string="Interns observing this patient"/>
                    <separator string="Ward Round Logs"/>
                    <field name="ward_round_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="intern_id" string="Intern"/>
                            <field name="supervising_doctor_id" string="Supervisor"/>
                            <field name="bp_systolic" string="BP Sys"/>
                            <field name="bp_diastolic" string="BP Dia"/>
                            <field name="temperature" string="Temp"/>
                            <field name="bmi"/>
                            <field name="is_signed_off" string="Signed"/>
                        </list>
                    </field>
                </page>


                <page string="Room Transfers" name="room_transfers">
                    <field name="room_transfer_ids">
                        <list>
                            <field name="transfer_date" string="Date"/>
                            <field name="from_room_id" string="From Room"/>
                            <field name="to_room_id" string="To Room"
                                   domain="[('state', '=', 'avail')]"/>
                            <field name="reason"/>
                            <field name="authorised_by" string="Authorised By"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- 7. Override action_invoice button — add all groups + rename -->
            <xpath expr="//button[@name='action_invoice']" position="attributes">
                <attribute name="string">Generate Comprehensive Discharge Bill</attribute>
                <attribute name="groups">base_hospital_management.base_hospital_management_group_manager,base_hospital_management.base_hospital_management_group_receptionist,base_hospital_management.base_hospital_management_group_nurse,base_hospital_management.base_hospital_management_group_doctor</attribute>
            </xpath>

            <!-- 8. Override Discharge button — add doctor group -->
            <xpath expr="//button[@name='action_discharge']" position="attributes">
                <attribute name="groups">base_hospital_management.base_hospital_management_group_manager,base_hospital_management.base_hospital_management_group_receptionist,base_hospital_management.base_hospital_management_group_nurse,base_hospital_management.base_hospital_management_group_doctor</attribute>
            </xpath>

            <!-- 9. Discharge Summary button — after action_discharge -->
            <xpath expr="//button[@name='action_discharge']" position="after">
                <button name="action_print_discharge_summary" type="object"
                        string="Print Discharge Summary"
                        invisible="state not in ['invoice','dis']"
                        icon="fa-file-text-o"/>
            </xpath>
            
            <!-- IP + Daily Procedures: same wizard concept as the OP
                 side's "OP + Daily Procedures" button. Anchored on the
                 existing "Create Test" button by @name (a valid,
                 non-translatable inheritance selector). Only shown
                 once the patient is actually admitted (state == 'admit'),
                 same visibility rule already used on "Create Test". -->
            <xpath expr="//button[@name='action_create_lab_test']" position="after">
                <button name="action_ip_daily_procedures"
                        string="IP + Daily Procedures"
                        class="btn btn-warning"
                        type="object"
                        invisible="state != 'admit'"
                        groups="base_hospital_management.base_hospital_management_group_manager,base_hospital_management.base_hospital_management_group_doctor,base_hospital_management.base_hospital_management_group_receptionist"/>
            </xpath>

           
            <!-- Add Doctor group to Create Lab Test button -->
            <xpath expr="//button[@name='action_create_lab_test']" position="attributes">
                <attribute name="groups">base_hospital_management.base_hospital_management_group_manager,base_hospital_management.base_hospital_management_group_doctor,base_hospital_management.base_hospital_management_group_receptionist,base_hospital_management.base_hospital_management_group_nurse,santhigiri_hms.group_rmo</attribute>
            </xpath>

        </field>
    </record>

    <!-- Inpatient Tree View Extension with Initial Assessment Button & Key Patient Details -->
    <record id="view_inpatient_tree_santhigiri" model="ir.ui.view">
        <field name="name">hospital.inpatient.tree.santhigiri</field>
        <field name="model">hospital.inpatient</field>
        <field name="inherit_id" ref="base_hospital_management.hospital_inpatient_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="patient_id"/>
                <field name="uhid_no"/>
                <field name="patient_category" widget="badge"/>
                <field name="attending_doctor_id"/>
                <button name="action_open_assessment" type="object"
                        string="Initial Assessment"
                        icon="fa-stethoscope"
                        class="btn-primary btn-sm"/>
                <button name="action_open_procedure_schedule" type="object"
                        string="Procedure Schedule"
                        icon="fa-calendar-check-o"
                        class="btn-success btn-sm"/>
            </xpath>
            <xpath expr="//field[@name='discharge_date']" position="after">
                <field name="state" widget="badge"/>
            </xpath>
        </field>
    </record>
</odoo>