<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inpatient_form_santhigiri" model="ir.ui.view">
        <field name="name">hospital.inpatient.form.santhigiri</field>
        <field name="model">hospital.inpatient</field>
        <field name="inherit_id" ref="base_hospital_management.hospital_inpatient_view_form"/>
        <field name="arch" type="xml">

            <!-- 1. Add patient_category right after patient_id -->
            <xpath expr="//field[@name='patient_id']" position="after">
                <field name="patient_category"
                       required="1"
                       string="IP Category"/>
            </xpath>

            <!-- Add ot_charge after operating_doctor_id -->
            <xpath expr="//field[@name='operating_doctor_id']" position="after">
                <field name="ot_charge" widget="monetary" string="OT / Surgical Charges"/>
            </xpath>

            <!-- 2. Add nurse + diet after type_admission -->
            <xpath expr="//field[@name='type_admission']" position="after">
                <field name="assigned_nurse_id" string="Assigned Nurse"/>
                <field name="diet_plan_id" string="Diet Plan"/>
            </xpath>

            <!-- 3. Add advance fields after reason -->
            <xpath expr="//field[@name='reason']" position="after">
                <field name="advance_percent" string="Advance %"/>
                <field name="advance_amount" widget="monetary" string="Advance Collected"/>
            </xpath>

            <!-- 4. Add is_ward (Accommodation Type) in the right group
                 next to type_admission — keeps it in 2-column layout -->
            <xpath expr="//field[@name='enable_outpatient']" position="after">
                <field name="is_ward" string="Accommodation Type"/>
                <field name="bed_id"
                       string="Bed"
                       options="{&quot;no_create&quot;: true}"
                       invisible="is_ward != 'ward'"/>
                <field name="ward_id"
                       string="Ward"
                       options="{&quot;no_create&quot;: true}"
                       invisible="is_ward != 'ward'"/>
                <field name="room_id"
                       string="Room"
                       options="{&quot;no_create&quot;: true}"
                       invisible="is_ward != 'room'"/>
                <field name="bed_rent"
                       string="Bed Rent / Day"
                       invisible="is_ward != 'ward'"/>
                <field name="room_rent"
                       string="Room Rent / Day"
                       invisible="is_ward != 'room'"/>
            </xpath>

            <!-- 5. Bystander Pass + Service Charge after bed_rent_amount -->
            <xpath expr="//field[@name='bed_rent_amount']" position="after">
                <field name="service_charge" widget="monetary" string="Service Charges"/>
                <separator string="Bystander Pass"/>
                <field name="bystander_name" string="Bystander Name"/>
                <field name="bystander_relation" string="Relation to Patient"/>
                <field name="bystander_pass_no" readonly="1" string="Pass No."/>
                <button name="action_generate_bystander_pass" type="object"
                        string="Generate &amp; Print Bystander Pass"
                        invisible="not bystander_name"/>
            </xpath>

            <!-- 6. New tabs after Nursing Plan -->
            <xpath expr="//page[@name='Nursing Plan']" position="after">
                <page string="Treatment Plan (Procedures)" name="treatment_plan">
                    <field name="treatment_plan_ids">
                        <list string="Treatment Plans">
                            <field name="procedure_id" string="Procedure / Therapy"/>
                            <field name="frequency"/>
                            <field name="no_of_sessions" string="Sessions"/>
                            <field name="completed_sessions" string="Done"/>
                            <field name="therapist_ids" widget="many2many_tags" string="Therapist(s)"/>
                            <field name="rmo_approved" string="RMO ✓"/>
                            <field name="procedure_charge" widget="monetary" string="Charge"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>

                <page string="Medication Plan (Medicines)" name="medication_plan">
                    <button name="action_dispense_ip_medicines"
                            type="object"
                            string="💊 Send to Pharmacy"
                            class="btn btn-primary mb-2"
                            groups="base_hospital_management.base_hospital_management_group_doctor,base_hospital_management.base_hospital_management_group_manager,santhigiri_hms.group_rmo"
                            confirm="Send all Medication Plan medicines to the IP Pharmacy for dispensing?"/>
                    <field name="medication_plan_ids">
                        <list editable="bottom">
                            <field name="medicine_id" string="Medicine"/>
                            <field name="dosage"/>
                            <field name="frequency"/>
                            <field name="duration_days" string="Days"/>
                            <field name="anupanam"/>
                            <field name="route"/>
                            <field name="total_charge" widget="monetary" string="Charge"/>
                        </list>
                    </field>
                </page>

                <page string="Food &amp; Diet" name="food_diet">
                    <group>
                        <field name="diet_plan_id" string="Diet Plan"/>
                        <field name="food_charges_total" widget="monetary"
                               readonly="1" string="Total Food Charges"/>
                    </group>
                    <separator string="Daily Food Supply"/>
                    <field name="food_supply_ids">
                        <list editable="bottom">
                            <field name="supply_date" string="Date"/>
                            <field name="meal_type" string="Meal"/>
                            <field name="diet_plan_id" string="Diet Plan"/>
                            <field name="additional_items" string="Additional Items"/>
                            <field name="charge" widget="monetary" string="Charge"/>
                            <field name="bystander_meal" string="Bystander Meal"/>
                        </list>
                    </field>
                </page>

                <page string="Consent &amp; Follow-Up" name="consent">
                    <group string="Consent Forms (Upload signed documents)">
                        <div class="alert alert-info" style="margin-bottom:10px;">
                            <strong>How to upload:</strong>
                            Print consent form → Get patient/family signature →
                            Scan → Click upload below.
                        </div>
                        <field name="consent_form_ids"
                               widget="many2many_binary"
                               string="Signed Consent Forms"
                               nolabel="1"
                               colspan="2"/>
                    </group>
                    <separator string="Follow-Up Appointments"/>
                    <field name="followup_ids">
                        <list>
                            <field name="followup_date" string="Date"/>
                            <field name="reason" string="Instructions"/>
                            <field name="status" widget="badge"/>
                        </list>
                    </field>
                </page>

                <page string="Room Transfers" name="room_transfers">
                    <field name="room_transfer_ids">
                        <list>
                            <field name="transfer_date" string="Date"/>
                            <field name="from_room_id" string="From Room"/>
                            <field name="to_room_id" string="To Room"
                                   domain="[('state', '=', 'avail')]"/>
                            <field name="reason"/>
                            <field name="authorised_by" string="Authorised By"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- 7. Override action_invoice button — add all groups + rename -->
            <xpath expr="//button[@name='action_invoice']" position="attributes">
                <attribute name="string">Generate Comprehensive Discharge Bill</attribute>
                <attribute name="groups">base_hospital_management.base_hospital_management_group_manager,base_hospital_management.base_hospital_management_group_receptionist,base_hospital_management.base_hospital_management_group_nurse,base_hospital_management.base_hospital_management_group_doctor</attribute>
            </xpath>

            <!-- 8. Override Discharge button — add doctor group -->
            <xpath expr="//button[@name='action_discharge']" position="attributes">
                <attribute name="groups">base_hospital_management.base_hospital_management_group_manager,base_hospital_management.base_hospital_management_group_receptionist,base_hospital_management.base_hospital_management_group_nurse,base_hospital_management.base_hospital_management_group_doctor</attribute>
            </xpath>

            <!-- 9. Discharge Summary button — after action_discharge -->
            <xpath expr="//button[@name='action_discharge']" position="after">
                <button name="action_print_discharge_summary" type="object"
                        string="Print Discharge Summary"
                        invisible="state not in ['invoice','dis']"
                        icon="fa-file-text-o"/>
            </xpath>

           
            <!-- Add Doctor group to Create Lab Test button -->
            <xpath expr="//button[@name='action_create_lab_test']" position="attributes">
                <attribute name="groups">base_hospital_management.base_hospital_management_group_manager,base_hospital_management.base_hospital_management_group_doctor,base_hospital_management.base_hospital_management_group_receptionist,base_hospital_management.base_hospital_management_group_nurse,santhigiri_hms.group_rmo</attribute>
            </xpath>

        </field>
    </record>
</odoo>