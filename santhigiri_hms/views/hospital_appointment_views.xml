<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Appointment Form View -->
    <record id="view_hospital_appointment_form" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form string="Patient Appointment">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm Appointment" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_create_op_registration" type="object"
                            string="Register Patient (Create OP)" class="btn-success"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state in ('cancel', 'registered')"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Pending"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,registered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_op_registration" type="object"
                                class="oe_stat_button" icon="fa-hospital-o"
                                invisible="not outpatient_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">OP Visit</span>
                                <span class="o_stat_value"><field name="outpatient_id" readonly="1"/></span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Patient Information">
                            <field name="patient_id"
                                   placeholder="Select existing patient or type name below..."/>
                            <field name="patient_name"/>
                            <field name="patient_phone" widget="phone"/>
                            <field name="patient_email" widget="email"/>
                        </group>
                        <group string="Department &amp; Doctor Preferred">
                            <field name="department_id"
                                   options="{'no_create': True, 'no_edit': True}"/>
                            <field name="doctor_id"
                                   options="{'no_create': True, 'no_edit': True}"/>
                        </group>
                    </group>

                    <group>
                        <group string="Appointment Schedule">
                            <field name="appointment_datetime"/>
                            <field name="appointment_reason" widget="radio"/>
                        </group>
                        <group string="Confirmation">
                            <field name="is_confirmed" widget="boolean_toggle"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>

                    <group string="Reason / Clinical Notes">
                        <field name="notes" nolabel="1"
                               placeholder="Reason for visit, chief complaints, counselling notes, or yoga booking details..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Appointment List / Tree View -->
    <record id="view_hospital_appointment_list" model="ir.ui.view">
        <field name="name">hospital.appointment.list</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <list string="Patient Appointments" decoration-info="state == 'draft'"
                  decoration-success="state in ('confirmed', 'registered')"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="patient_name"/>
                <field name="patient_phone"/>
                <field name="department_id"/>
                <field name="doctor_id"/>
                <field name="appointment_datetime"/>
                <field name="appointment_reason" widget="badge"
                       decoration-info="appointment_reason == 'consultation'"
                       decoration-warning="appointment_reason == 'counselling'"
                       decoration-success="appointment_reason == 'yoga'"/>
                <field name="is_confirmed" widget="boolean_toggle"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-success="state in ('confirmed', 'registered')"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Appointment Search View -->
    <record id="view_hospital_appointment_search" model="ir.ui.view">
        <field name="name">hospital.appointment.search</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <search string="Search Appointments">
                <field name="name" string="Appointment ID"/>
                <field name="patient_name" string="Patient Name"/>
                <field name="patient_phone" string="Phone"/>
                <field name="department_id"/>
                <field name="doctor_id"/>
                <separator/>
                <filter string="Confirmed" name="confirmed"
                        domain="[('is_confirmed', '=', True)]"/>
                <filter string="Pending Confirmation" name="pending"
                        domain="[('is_confirmed', '=', False), ('state', '=', 'draft')]"/>
                <filter string="Registered in OP" name="registered"
                        domain="[('state', '=', 'registered')]"/>
                <separator/>
                <filter string="Today's Appointments" name="today"
                        domain="[('appointment_datetime', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('appointment_datetime', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <separator/>
                <filter string="Consultation" name="reason_consultation"
                        domain="[('appointment_reason', '=', 'consultation')]"/>
                <filter string="Counselling" name="reason_counselling"
                        domain="[('appointment_reason', '=', 'counselling')]"/>
                <filter string="Yoga" name="reason_yoga"
                        domain="[('appointment_reason', '=', 'yoga')]"/>
                <group name="group_by">
                    <filter string="Department" name="group_dept"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Doctor" name="group_doctor"
                            context="{'group_by': 'doctor_id'}"/>
                    <filter string="Reason" name="group_reason"
                            context="{'group_by': 'appointment_reason'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date"
                            context="{'group_by': 'appointment_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_hospital_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_appointment_search"/>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Book a new Patient Appointment
            </p>
            <p>
                Manage doctor &amp; department preferred appointments for Consultation,
                Counselling, or Yoga with confirmation tracking.
            </p>
        </field>
    </record>

    <!-- Menuitem: Put Appointments right under the main Appointment root -->
    <menuitem id="menu_hospital_appointment"
              name="Appointments"
              parent="base_hospital_management.hospital_menu_appointment"
              action="action_hospital_appointment"
              sequence="0"/>

</odoo>
