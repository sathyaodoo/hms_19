<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hospital Department Tree / List View -->
    <record id="hospital_department_view_tree" model="ir.ui.view">
        <field name="name">hospital.department.view.list</field>
        <field name="model">hospital.department</field>
        <field name="arch" type="xml">
            <list string="Hospital Departments" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="head_doctor_id" options="{'no_create': True}"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Hospital Department Form View -->
    <record id="hospital_department_view_form" model="ir.ui.view">
        <field name="name">hospital.department.view.form</field>
        <field name="model">hospital.department</field>
        <field name="arch" type="xml">
            <form string="Hospital Department">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Department Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Kayachikitsa"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. KC"/>
                            <field name="head_doctor_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Department Staff / Members" name="members">
                            <field name="member_ids" widget="many2many">
                                <list>
                                    <field name="name"/>
                                    <field name="work_phone"/>
                                    <field name="work_email"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description / Specialities" name="description">
                            <field name="description" placeholder="Department specialities and clinical details..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Hospital Department Search View -->
    <record id="hospital_department_view_search" model="ir.ui.view">
        <field name="name">hospital.department.view.search</field>
        <field name="model">hospital.department</field>
        <field name="arch" type="xml">
            <search string="Search Hospital Department">
                <field name="name"/>
                <field name="code"/>
                <field name="head_doctor_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hospital_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hospital.department</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Hospital Department
            </p>
            <p>
                Define your medical and clinical hospital departments (e.g. Kayachikitsa, Panchakarma, Shalya Tantra).
            </p>
        </field>
    </record>
</odoo>
