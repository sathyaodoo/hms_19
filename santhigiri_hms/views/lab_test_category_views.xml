<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lab Test Category Form -->
    <record id="view_lab_test_category_form" model="ir.ui.view">
        <field name="name">lab.test.category.form</field>
        <field name="model">lab.test.category</field>
        <field name="arch" type="xml">
            <form string="Lab Test Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tests" type="object"
                                class="oe_stat_button"
                                icon="fa-flask">
                            <field name="test_count" widget="statinfo" string="Tests"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Category Name"/></h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                    <separator string="Tests in this Category"/>
                    <field name="test_ids">
                        <list>
                            <field name="name"/>
                            <field name="default_normal_range" string="Normal Range"/>
                            <field name="default_uom_id" string="Unit"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Lab Test Category List -->
    <record id="view_lab_test_category_list" model="ir.ui.view">
        <field name="name">lab.test.category.list</field>
        <field name="model">lab.test.category</field>
        <field name="arch" type="xml">
            <list string="Lab Test Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="test_count" string="Tests"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_lab_test_category" model="ir.actions.act_window">
        <field name="name">Lab Test Categories</field>
        <field name="res_model">lab.test.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Tests filtered by category -->
    <record id="action_lab_test_category_tests" model="ir.actions.act_window">
        <field name="name">Tests</field>
        <field name="res_model">lab.test</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category_id', '=', active_id)]</field>
    </record>

    <!-- Add category_id to lab.test form -->
    <record id="view_lab_test_category_field" model="ir.ui.view">
        <field name="name">lab.test.category.field</field>
        <field name="model">lab.test</field>
        <field name="inherit_id" ref="base_hospital_management.lab_test_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="category_id" string="Category"
                       options="{'no_create': false}"/>
            </xpath>
        </field>
    </record>

    <!-- Add category to lab.test list -->
    <record id="view_lab_test_category_list_field" model="ir.ui.view">
        <field name="name">lab.test.category.list.field</field>
        <field name="model">lab.test</field>
        <field name="inherit_id" ref="base_hospital_management.lab_test_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="category_id" string="Category" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Configuration menu -->
    <menuitem id="menu_lab_test_category"
              name="Lab Test Categories"
              parent="base_hospital_management.hospital_menu_laboratory"
              action="action_lab_test_category"
              sequence="25"
              groups="base_hospital_management.base_hospital_management_group_manager,base_hospital_management.base_hospital_management_group_lab_assistant"/>

</odoo>