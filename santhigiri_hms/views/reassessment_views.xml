<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_op_reassessment_form" model="ir.ui.view">
        <field name="name">hospital.op.reassessment.form</field>
        <field name="model">hospital.op.reassessment</field>
        <field name="arch" type="xml">
            <form string="OP Reassessment Chart">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print" type="object" string="Print"
                            class="btn-secondary" icon="fa-print"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                        <span class="text-muted">Form No: SAMC/CS/14</span>
                    </div>
                    <group>
                        <group string="Patient / Visit">
                            <field name="outpatient_id"
                                   readonly="context.get('default_outpatient_id')"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="patient_seq" readonly="1"/>
                            <field name="doctor_id" readonly="1" string="Consultant"/>
                            <field name="followup_id"/>
                        </group>
                        <group string="Identifiers">
                            <field name="assessment_datetime"/>
                            <field name="uhid_no"/>
                            <field name="cop_no"/>
                            <field name="dop_no"/>
                        </group>
                    </group>

                    <group string="Observations">
                        <group>
                            <field name="bp"/>
                            <field name="pr"/>
                            <field name="naadi"/>
                        </group>
                    </group>

                    <separator string="Medication with Route / Dose / Time / Duration / Anupana / Pathya-Apathya"/>
                    <field name="prescription_ids">
                        <list editable="bottom">
                            <field name="medicine_id"/>
                            <field name="route"/>
                            <field name="no_intakes" string="Dose"/>
                            <field name="time"/>
                            <field name="duration_days" string="Duration (Days)"/>
                            <field name="anupanam" string="Anupana"/>
                            <field name="pathya_apathya" string="Pathya-Apathya"/>
                        </list>
                    </field>

                    <group string="Sign-off" invisible="state != 'confirmed'">
                        <field name="consultant_signoff_id"/>
                        <field name="signoff_date"/>
                        <field name="signoff_time"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_op_reassessment_list" model="ir.ui.view">
        <field name="name">hospital.op.reassessment.list</field>
        <field name="model">hospital.op.reassessment</field>
        <field name="arch" type="xml">
            <list string="OP Reassessment Charts">
                <field name="reference"/>
                <field name="patient_id"/>
                <field name="assessment_datetime"/>
                <field name="doctor_id"/>
                <field name="bp"/>
                <field name="pr"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_op_reassessment" model="ir.actions.act_window">
        <field name="name">OP Reassessment Charts</field>
        <field name="res_model">hospital.op.reassessment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Smart button on the OP form -->
    <record id="view_outpatient_form_reassessment_button" model="ir.ui.view">
        <field name="name">hospital.outpatient.form.reassessment.button</field>
        <field name="model">hospital.outpatient</field>
        <field name="inherit_id" ref="base_hospital_management.hospital_outpatient_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_reassessment" type="object"
                        class="oe_stat_button" icon="fa-refresh">
                    <field name="reassessment_count" widget="statinfo"
                           string="Reassessments"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>