<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_lab_test_date_report_wizard_form" model="ir.ui.view">
        <field name="name">lab.test.date.report.wizard.form</field>
        <field name="model">lab.test.date.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Lab Test Datewise Report">
                <group>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button name="action_print_pdf"
                            string="Print PDF"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lab_test_date_report_wizard" model="ir.actions.act_window">
        <field name="name">Lab Test Datewise Report</field>
        <field name="res_model">lab.test.date.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_lab_test_datewise_report"
              name="Lab Test Datewise Report"
              parent="base_hospital_management.hospital_menu_laboratory"
              action="action_lab_test_date_report_wizard"
              sequence="50"/>

</odoo>
