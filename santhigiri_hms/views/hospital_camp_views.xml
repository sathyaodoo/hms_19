<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Medical Camp Form View -->
    <record id="view_hospital_camp_form" model="ir.ui.view">
        <field name="name">hospital.camp.form</field>
        <field name="model">hospital.camp</field>
        <field name="arch" type="xml">
            <form string="Medical Camp">
                <header>
                    <button name="action_activate_camp"
                            string="Activate Camp"
                            type="object"
                            class="btn btn-success"
                            invisible="state != 'planned'"/>
                    <button name="action_close_camp"
                            string="Close Camp"
                            type="object"
                            class="btn btn-secondary"
                            invisible="state != 'active'"/>
                    <button name="action_print_camp_report"
                            string="Print Camp Report"
                            type="object"
                            icon="fa-print"
                            invisible="state == 'planned'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planned,active,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Camp Name"/></h1>
                    </div>
                    <group>
                        <group string="Camp Details">
                            <field name="camp_date"/>
                            <field name="location"/>
                            <field name="speciality"/>
                            <field name="organiser_dept_id"/>
                            <field name="sponsor"/>
                        </group>
                        <group string="Discount Configuration">
                            <field name="discount_type" widget="radio"/>
                            <field name="discount_value"
                                   invisible="discount_type == 'free'"
                                   string="Discount Value (% or ₹)"/>
                            <field name="patient_count" readonly="1" string="Patients Registered"/>
                            <field name="state" invisible="1"/>
                        </group>
                    </group>
                    <!-- Camp Report Summary -->
                    <group string="Camp Report Summary" name="report_summary">
                        <group>
                            <field name="total_patients" readonly="1" string="Patients Seen"/>
                            <field name="total_value" readonly="1" widget="monetary"
                                   string="Total Service Value"/>
                        </group>
                        <group>
                            <field name="total_discount" readonly="1" widget="monetary"
                                   string="Total Discount Given"/>
                            <field name="actual_revenue" readonly="1" widget="monetary"
                                   string="Actual Revenue"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Camp Patients" name="patients">
                            <field name="outpatient_ids">
                                <list>
                                    <field name="op_reference" string="OP Reference"/>
                                    <field name="patient_id" string="Patient"/>
                                    <field name="doctor_id" string="Doctor"/>
                                    <field name="op_date" string="Date"/>
                                    <field name="reason" string="Reason"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"
                                   placeholder="Camp notes, remarks, special instructions..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Medical Camp List View -->
    <record id="view_hospital_camp_list" model="ir.ui.view">
        <field name="name">hospital.camp.list</field>
        <field name="model">hospital.camp</field>
        <field name="arch" type="xml">
            <list string="Medical Camps"
                  decoration-success="state == 'active'"
                  decoration-muted="state in ['done','cancelled']">
                <field name="name"/>
                <field name="camp_date"/>
                <field name="location"/>
                <field name="speciality"/>
                <field name="discount_type"/>
                <field name="patient_count" string="Patients"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hospital_camp" model="ir.actions.act_window">
        <field name="name">Medical Camps</field>
        <field name="res_model">hospital.camp</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'list','view_id':ref('view_hospital_camp_list')}),
            (0,0,{'view_mode':'form','view_id':ref('view_hospital_camp_form')})]"/>
    </record>
</odoo>