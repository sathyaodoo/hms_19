<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- IP Initial Assessment List -->
    <record id="view_hospital_ip_assessment_list" model="ir.ui.view">
        <field name="name">hospital.ip.assessment.list</field>
        <field name="model">hospital.ip.assessment</field>
        <field name="arch" type="xml">
            <list string="IP Initial Assessments">
                <field name="reference"/>
                <field name="assessment_datetime"/>
                <field name="inpatient_id"/>
                <field name="patient_id"/>
                <field name="patient_seq"/>
                <field name="doctor_id"/>
                <field name="nutritional_screening"/>
                <field name="pain_score"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- IP Initial Assessment Form -->
    <record id="view_hospital_ip_assessment_form" model="ir.ui.view">
        <field name="name">hospital.ip.assessment.form</field>
        <field name="model">hospital.ip.assessment</field>
        <field name="arch" type="xml">
            <form string="Initial Assessment Sheet - IP">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_print" type="object"
                            string="Print" class="btn-secondary"
                            icon="fa-print"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                        <span class="text-muted">Form No: SAMC/CS/11</span>
                    </div>

                    <group>
                        <group string="Patient / Admission">
                            <field name="inpatient_id"
                                   readonly="state == 'confirmed'"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="patient_seq" readonly="1"/>
                            <field name="doctor_id" string="Consultant"
                                   readonly="1"/>
                            <field name="department_id"
                                   readonly="state == 'confirmed'"/>
                        </group>
                        <group string="Identifiers">
                            <field name="assessment_datetime"
                                   readonly="state == 'confirmed'"/>
                            <field name="uhid_no"
                                   readonly="state == 'confirmed'"/>
                            <field name="cop_no"
                                   readonly="state == 'confirmed'"/>
                            <field name="dop_no"
                                   readonly="state == 'confirmed'"/>
                        </group>
                    </group>

                    <group string="Vitals">
                        <group>
                            <field name="respiratory_rate"
                                   readonly="state == 'confirmed'"/>
                            <field name="heart_rate"
                                   readonly="state == 'confirmed'"/>
                            <field name="pulse_rate"
                                   readonly="state == 'confirmed'"/>
                        </group>
                        <group>
                            <field name="height"
                                   readonly="state == 'confirmed'"/>
                            <field name="weight"
                                   readonly="state == 'confirmed'"/>
                            <field name="bmi" readonly="1"/>
                        </group>
                        <group>
                            <field name="bp"
                                   readonly="state == 'confirmed'"/>
                            <field name="temperature"
                                   readonly="state == 'confirmed'"/>
                            <field name="grbs"
                                   readonly="state == 'confirmed'"/>
                        </group>
                    </group>

                    <group>
                        <group string="Nutritional Screening">
                            <field name="nutritional_screening"
                                   widget="radio"
                                   readonly="state == 'confirmed'"/>
                        </group>
                        <group string="Pain Assessment">
                            <field name="pain_score" widget="radio"
                                   readonly="state == 'confirmed'"/>
                        </group>
                    </group>

                    <group string="Clinical Notes">
                        <field name="complaint_duration"
                               readonly="state == 'confirmed'"/>
                        <field name="presenting_complaints" nolabel="1"
                               colspan="2"
                               readonly="state == 'confirmed'"
                               placeholder="Presenting complaints and duration..."/>
                        <field name="current_medication" nolabel="1"
                               colspan="2"
                               readonly="state == 'confirmed'"
                               placeholder="Current medication..."/>
                        <field name="treatment_history" nolabel="1"
                               colspan="2"
                               readonly="state == 'confirmed'"
                               placeholder="Treatment history..."/>
                        <field name="investigations_recommended" nolabel="1"
                               colspan="2"
                               readonly="state == 'confirmed'"
                               placeholder="Investigations recommended..."/>
                    </group>

                    <notebook>
                        <page string="Care Plan Strategy" name="care_plan">
                            <group>
                                <field name="care_plan_curative"
                                       readonly="state == 'confirmed'"/>
                                <field name="care_plan_preventive"
                                       readonly="state == 'confirmed'"/>
                                <field name="care_plan_rehabilitative"
                                       readonly="state == 'confirmed'"/>
                                <field name="care_plan_outcome"
                                       readonly="state == 'confirmed'"
                                       placeholder="Care plan with desired outcome..."/>
                            </group>
                        </page>

                        <page string="Medication Order" name="medication_order">
                            <field name="medication_plan_ids"
                                   readonly="state == 'confirmed'">
                                <list>
                                    <field name="medicine_id"/>
                                    <field name="route"/>
                                    <field name="dosage"/>
                                    <field name="frequency"/>
                                    <field name="duration_days"/>
                                    <field name="start_date"/>
                                    <field name="anupanam"/>
                                    <field name="instructions"/>
                                </list>
                            </field>
                            <p class="text-muted mt-2">
                                Medication orders are linked to the IP Admission.
                            </p>
                        </page>

                        <page string="Treatment Order" name="treatment_order">
                            <field name="treatment_plan_ids"
                                   readonly="state == 'confirmed'">
                                <list>
                                    <field name="procedure_id"/>
                                    <field name="frequency"/>
                                    <field name="no_of_sessions"/>
                                    <field name="start_date"/>
                                    <field name="therapist_ids"
                                           widget="many2many_tags"/>
                                    <field name="instructions"/>
                                    <field name="state"/>
                                </list>
                            </field>
                            <p class="text-muted mt-2">
                                Treatment orders are linked to the IP Admission.
                            </p>
                        </page>
                    </notebook>

                    <group string="Consultant Sign-off"
                           invisible="state != 'confirmed'">
                        <field name="consultant_signoff_id" readonly="1"/>
                        <field name="signoff_date" readonly="1"/>
                        <field name="signoff_time" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hospital_ip_assessment" model="ir.actions.act_window">
        <field name="name">IP Initial Assessment</field>
        <field name="res_model">hospital.ip.assessment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_hospital_ip_assessment"
              name="IP Initial Assessments"
              parent="base_hospital_management.hospital_menu_root"
              action="action_hospital_ip_assessment"
              sequence="85"/>

</odoo>
