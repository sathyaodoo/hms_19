<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add pharmacy_type field to pharmacy form -->
    <record id="view_hospital_pharmacy_form_santhigiri" model="ir.ui.view">
        <field name="name">hospital.pharmacy.form.santhigiri</field>
        <field name="model">hospital.pharmacy</field>
        <field name="inherit_id" ref="base_hospital_management.hospital_pharmacy_view_form"/>
        <field name="arch" type="xml">
            <!-- Add pharmacy_type inside the existing <group> before pharmacist_id -->
            <xpath expr="//field[@name='pharmacist_id']" position="before">
                <field name="pharmacy_type" widget="radio" string="Pharmacy Type"/>
                <field name="location_id" string="Pharmacy Store Location"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- Sale Order list view for Pharmacist — shows dispensing info clearly -->
    <record id="view_sale_order_pharmacy_list" model="ir.ui.view">
        <field name="name">sale.order.pharmacy.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-info">dispensing_category == 'patient_medication'</attribute>
                <attribute name="decoration-warning">dispensing_category == 'op_dispensing'</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="dispensing_category" string="Type" optional="show"/>
                <field name="inpatient_id" string="IP Admission" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Sale Order FORM view — show dispensing_category field -->
    <record id="view_sale_order_pharmacy_form" model="ir.ui.view">
        <field name="name">sale.order.pharmacy.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="dispensing_category"
                       string="Dispensing Category"
                       invisible="not dispensing_category"/>
                <field name="inpatient_id"
                       string="IP Admission"
                       invisible="not inpatient_id"
                       readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>