<?xml version="1.0" encoding="utf-8"?>
<templates>
    <!-- Override lab dashboard row template to add priority color -->
    <t t-inherit="base_hospital_management.LabDashboard"
       t-inherit-mode="extension">
        <xpath expr="//tr[hasclass('tests-confirmed')]" position="attributes">
            <attribute name="t-att-class">
                'tests-confirmed' +
                (test.priority === 'stat' ? ' table-danger' :
                 test.priority === 'urgent' ? ' table-warning' : '')
            </attribute>
        </xpath>
    </t>
</templates>