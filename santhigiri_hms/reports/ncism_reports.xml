<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Internship Completion Certificate -->
    <record id="action_report_intern_completion" model="ir.actions.report">
        <field name="name">Internship Completion Certificate</field>
        <field name="model">hospital.intern</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">santhigiri_hms.report_intern_completion</field>
        <field name="print_report_name">'Completion_' + (object.intern_seq or '')</field>
        <field name="binding_model_id" ref="model_hospital_intern"/>
    </record>

    <template id="report_intern_completion">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page text-center">
                        <h3>SANTHIGIRI AYURVEDA HOSPITAL</h3>
                        <h5>Thiruvananthapuram, Kerala</h5>
                        <h4 class="mt-3"><u>INTERNSHIP COMPLETION CERTIFICATE</u></h4>
                        <hr/>
                        <p class="mt-3">This is to certify that</p>
                        <h4><t t-esc="doc.name"/></h4>
                        <p>ID: <t t-esc="doc.intern_seq"/> | College Reg: <t t-esc="doc.college_register_no or ''"/></p>
                        <p>has successfully completed the internship programme at Santhigiri Ayurveda Hospital.</p>
                        <table class="table table-bordered mt-3 text-start">
                            <tr><td><strong>Course</strong></td><td><t t-esc="doc.course or ''"/></td></tr>
                            <tr><td><strong>Institution</strong></td><td><t t-esc="doc.college_id or ''"/></td></tr>
                            <tr><td><strong>University Reg. No.</strong></td><td><t t-esc="doc.university_reg_no or ''"/></td></tr>
                            <tr><td><strong>Attendance</strong></td>
                                <td><t t-esc="'%.1f' % doc.attendance_pct"/>%</td></tr>
                            <tr><td><strong>Total Cases Logged</strong></td><td><t t-esc="doc.total_cases"/></td></tr>
                        </table>
                        <t t-if="doc.rotation_ids">
                            <h5 class="mt-3">Department Rotations</h5>
                            <table class="table table-sm table-bordered">
                                <thead><tr><th>Department</th><th>From</th><th>To</th><th>Supervisor</th></tr></thead>
                                <tbody>
                                    <t t-foreach="doc.rotation_ids" t-as="rot">
                                        <tr>
                                            <td><t t-esc="rot.dept_id.name if rot.dept_id else ''"/></td>
                                            <td><t t-esc="rot.start_date" t-options='{"widget":"date"}'/></td>
                                            <td><t t-esc="rot.end_date" t-options='{"widget":"date"}'/></td>
                                            <td><t t-esc="rot.supervisor_id.name if rot.supervisor_id else '—'"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <div class="row mt-5">
                            <div class="col-4">
                                HOD Signature:<br/><br/>______________<br/>
                                <t t-esc="doc.supervisor_hod_id.name if doc.supervisor_hod_id else ''"/>
                            </div>
                            <div class="col-4">
                                DMS Signature:<br/><br/>______________<br/>
                                <t t-esc="doc.approved_by.name if doc.approved_by else ''"/>
                            </div>
                            <div class="col-4">Medical Director:<br/><br/>______________<br/>&amp; Hospital Seal</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- NCISM OPD Register -->
    <record id="action_report_ncism_opd" model="ir.actions.report">
        <field name="name">NCISM OPD Register</field>
        <field name="model">hospital.outpatient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">santhigiri_hms.report_ncism_opd</field>
        <field name="binding_model_id" ref="base_hospital_management.model_hospital_outpatient"/>
    </record>

    <template id="report_ncism_opd">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h4 class="text-center">NCISM OPD REGISTER — Santhigiri Ayurveda Hospital</h4>
                    <table class="table table-sm table-bordered mt-3">
                        <thead>
                            <tr>
                                <th>Sl No.</th><th>Date</th><th>OP Ref</th>
                                <th>Patient Name</th><th>Patient No.</th>
                                <th>Diagnosis</th><th>Doctor</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="op">
                                <tr>
                                    <td><t t-esc="op_index + 1"/></td>
                                    <td><t t-esc="op.op_date" t-options='{"widget":"date"}'/></td>
                                    <td><t t-esc="op.op_reference"/></td>
                                    <td><t t-esc="op.patient_id.name"/></td>
                                    <td><t t-esc="op.patient_id.patient_seq or ''"/></td>
                                    <td><t t-esc="op.provisional_diagnosis or op.reason or '—'"/></td>
                                    <td><t t-esc="op.doctor_id.doctor_id.name if op.doctor_id and hasattr(op.doctor_id, 'doctor_id') else '—'"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>