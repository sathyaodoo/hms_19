<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_discharge_summary" model="ir.actions.report">
        <field name="name">Patient Discharge Summary</field>
        <field name="model">hospital.inpatient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">santhigiri_hms.report_discharge_summary</field>
        <field name="print_report_name">'Discharge_Summary_' + (object.name or '')</field>
        <field name="binding_model_id" ref="model_hospital_inpatient"/>
    </record>

    <template id="report_discharge_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center">
                            <h3>SANTHIGIRI AYURVEDA HOSPITAL</h3>
                            <h5>Thiruvananthapuram, Kerala</h5>
                            <h4><u>PATIENT DISCHARGE SUMMARY</u></h4>
                        </div>
                        <hr/>
                        <table class="table table-bordered mt-3">
                            <tr>
                                <td><strong>Admission No.</strong></td><td><t t-esc="doc.name"/></td>
                                <td><strong>Patient No.</strong></td><td><t t-esc="doc.patient_id.patient_seq or ''"/></td>
                            </tr>
                            <tr>
                                <td><strong>Patient Name</strong></td><td><t t-esc="doc.patient_id.name"/></td>
                                <td><strong>Category</strong></td>
                                <td><t t-esc="doc.patient_category or ''"/></td>
                            </tr>
                            <tr>
                                <td><strong>Admission Date</strong></td>
                                <td><t t-esc="doc.hosp_date" t-options='{"widget":"date"}'/></td>
                                <td><strong>Discharge Date</strong></td>
                                <td><t t-esc="doc.discharge_date" t-options='{"widget":"date"}'/></td>
                            </tr>
                            <tr>
                                <td><strong>Attending Doctor</strong></td>
                                <td><t t-esc="doc.attending_doctor_id.name if doc.attending_doctor_id else '—'"/></td>
                                <td><strong>Days Admitted</strong></td>
                                <td><t t-esc="doc.admit_days"/> days</td>
                            </tr>
                            <tr>
                                <td><strong>Room / Bed</strong></td>
                                <td><t t-esc="doc.room_id.name if doc.room_id else '—'"/> / <t t-esc="doc.bed_id.name if doc.bed_id else '—'"/></td>
                                <td><strong>Allergies</strong></td>
                                <td><t t-esc="doc.patient_id.allergy_summary or 'NIL'"/></td>
                            </tr>
                        </table>

                        <h5 class="mt-3">Reason for Admission / Diagnosis</h5>
                        <p><t t-esc="doc.reason or ''"/></p>

                        <t t-if="doc.treatment_plan_ids">
                            <h5>Treatment / Therapies Administered</h5>
                            <table class="table table-sm table-bordered">
                                <thead><tr><th>Procedure</th><th>Frequency</th><th>Sessions</th></tr></thead>
                                <tbody>
                                    <t t-foreach="doc.treatment_plan_ids" t-as="tp">
                                        <tr>
                                            <td><t t-esc="tp.procedure_id.name if tp.procedure_id else ''"/></td>
                                            <td><t t-esc="tp.frequency or ''"/></td>
                                            <td><t t-esc="tp.completed_sessions"/> / <t t-esc="tp.no_of_sessions"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="doc.medication_plan_ids">
                            <h5>Medicines at Discharge</h5>
                            <table class="table table-sm table-bordered">
                                <thead><tr><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th></tr></thead>
                                <tbody>
                                    <t t-foreach="doc.medication_plan_ids" t-as="mp">
                                        <tr>
                                            <td><t t-esc="mp.medicine_id.name if mp.medicine_id else ''"/></td>
                                            <td><t t-esc="mp.dosage or ''"/></td>
                                            <td><t t-esc="mp.frequency or ''"/></td>
                                            <td><t t-esc="mp.duration_days"/> days</td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <h5>Discharge Instructions</h5>
                        <p><t t-esc="doc.discharge_plan or 'Follow up as advised.'"/></p>

                        <t t-if="doc.followup_ids">
                            <h5>Follow-Up</h5>
                            <t t-foreach="doc.followup_ids" t-as="fu">
                                <p>Date: <strong><t t-esc="fu.followup_date" t-options='{"widget":"date"}'/></strong>
                                   — <t t-esc="fu.reason or ''"/></p>
                            </t>
                        </t>

                        <div class="row mt-4">
                            <div class="col-6">Hospital Emergency Contact:<br/>Phone: _______________</div>
                            <div class="col-6 text-end">
                                Doctor Signature:<br/><br/>________________________<br/>
                                <t t-esc="doc.attending_doctor_id.name if doc.attending_doctor_id else ''"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>