                                <td><t t-esc="fu.reason or '-'"/></td>
                                <td><t t-esc="fu.advised_by.name if fu.advised_by else '-'"/></td>
                                <td><t t-esc="fu.status"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
