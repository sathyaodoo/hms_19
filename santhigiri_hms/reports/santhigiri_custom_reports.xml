<!-- #19 Procedure Schedule Report -->
<template id="report_procedure_schedule">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="text-center mb-4">
                    <h2>Procedure Schedule Report</h2>
                </div>
                <table class="table table-bordered table-sm">
                    <thead class="table-primary">
                        <tr>
                            <th>Ref</th><th>Patient</th><th>Procedure</th>
                            <th>Therapist</th><th>Sessions</th><th>Done</th>
                            <th>Start</th><th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="proc">
                            <tr>
                                <td><t t-esc="proc.reference or '-'"/></td>
                                <td><t t-esc="proc.patient_id.name"/></td>
                                <td><t t-esc="proc.procedure_id.name if proc.procedure_id else '-'"/></td>
                                <td><t t-esc="', '.join(proc.therapist_ids.mapped('name')) or '-'"/></td>
                                <td><t t-esc="proc.no_of_sessions or 0"/></td>
                                <td><t t-esc="proc.completed_sessions or 0"/></td>
                                <td><t t-esc="proc.start_date or '-'"/></td>
                                <td><t t-esc="proc.state"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </t>
</template>

<!-- #22 Bed Occupancy Report -->
<template id="report_bed_occupancy">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="text-center mb-4">
                    <h2>Bed Occupancy Report</h2>
                    <h4>As on: <t t-esc="today"/></h4>
                </div>
                <table class="table table-bordered">
                    <thead class="table-primary">
                        <tr><th>Room / Bed</th><th>Bed Type</th><th>Rent</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="room">
                            <tr t-attf-class="{{ 'table-danger' if room.state == 'not' else 'table-success' }}">
                                <td><t t-esc="room.name"/></td>
                                <td><t t-esc="room.bed_type or '-'"/></td>
                                <td>₹ <t t-esc="'%.2f' % (room.rent or 0)"/></td>
                                <td><t t-esc="'Occupied' if room.state == 'not' else 'Available'"/></td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="table-info">
                            <td colspan="3">
                                Total: <t t-esc="len(docs)"/> |
                                Occupied: <t t-esc="len(docs.filtered(lambda r: r.state == 'not'))"/> |
                                Available: <t t-esc="len(docs.filtered(lambda r: r.state == 'avail'))"/>
                            </td>
                            <td>
                                Occupancy: <t t-esc="'%.1f' % (len(docs.filtered(lambda r: r.state == 'not')) / len(docs) * 100 if docs else 0)"/>%
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </t>
    </t>
</template>

</odoo>