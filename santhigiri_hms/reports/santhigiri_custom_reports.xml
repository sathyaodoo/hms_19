<!-- ══════════════════════════════════════════════════════════════════════════
     QWEB TEMPLATES
══════════════════════════════════════════════════════════════════════════ -->

<!-- #1 Daily OP Statistics -->
<template id="report_daily_op_stats">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="text-center mb-4">
                    <h2>Daily OP Statistics</h2>
                    <h4>Date: <t t-esc="today"/></h4>
                </div>
                <table class="table table-bordered">
                    <thead class="table-primary">
                        <tr>
                            <th>OP Reference</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Category</th>
                            <th>Fee</th>
                            <th>Outcome</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="op">
                            <tr>
                                <td><t t-esc="op.op_reference"/></td>
                                <td><t t-esc="op.patient_id.name"/></td>
                                <td><t t-esc="op.doctor_id.name or '-'"/></td>
                                <td><t t-esc="op.patient_category or '-'"/></td>
                                <td>₹ <t t-esc="'%.2f' % (op.category_fee or 0)"/></td>
                                <td><t t-esc="op.outcome or '-'"/></td>
                                <td><t t-esc="op.state"/></td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="table-info">
                            <td colspan="4"><strong>Total Patients: <t t-esc="len(docs)"/></strong></td>
                            <td><strong>₹ <t t-esc="'%.2f' % sum(op.category_fee or 0 for op in docs)"/></strong></td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </t>
    </t>
</template>

<!-- #2 OP Revenue Report -->
<template id="report_op_revenue">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="text-center mb-4">
                    <h2>OP Revenue Report</h2>
                </div>
                <table class="table table-bordered">
                    <thead class="table-primary">
                        <tr>
                            <th>OP Ref</th>
                            <th>Date</th>
                            <th>Patient</th>
                            <th>Category</th>
                            <th>Consultation Fee</th>
                            <th>Invoice Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="op">
                            <tr>
                                <td><t t-esc="op.op_reference"/></td>
                                <td><t t-esc="op.op_date"/></td>
                                <td><t t-esc="op.patient_id.name"/></td>
                                <td><t t-esc="op.patient_category or '-'"/></td>
                                <td>₹ <t t-esc="'%.2f' % (op.category_fee or 0)"/></td>
                                <td><t t-esc="op.state"/></td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="table-success">
                            <td colspan="4"><strong>Total Revenue</strong></td>
                            <td><strong>₹ <t t-esc="'%.2f' % sum(op.category_fee or 0 for op in docs)"/></strong></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </t>
    </t>
</template>

<!-- #3 IP Patient Census -->
<template id="report_ip_census">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="text-center mb-4">
                    <h2>IP Patient Census</h2>
                    <h4>Report Date: <t t-esc="today"/></h4>
                </div>
                <table class="table table-bordered table-sm">
                    <thead class="table-primary">
                        <tr>
                            <th>#</th>
                            <th>IP Ref</th>
                            <th>Patient</th>
                            <th>Admitted On</th>
                            <th>Doctor</th>
                            <th>Room</th>
                            <th>Category</th>
                            <th>Days</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="sno" t-value="0"/>
                        <t t-foreach="docs" t-as="ip">
                            <t t-set="sno" t-value="sno + 1"/>
                            <tr>
                                <td><t t-esc="sno"/></td>
                                <td><t t-esc="ip.name"/></td>
                                <td><t t-esc="ip.patient_id.name"/></td>
                                <td><t t-esc="ip.hosp_date"/></td>
                                <td><t t-esc="ip.attending_doctor_id.name or '-'"/></td>
                                <td><t t-esc="ip.room_id.name if ip.room_id else '-'"/></td>
                                <td><t t-esc="ip.patient_category or '-'"/></td>
                                <td><t t-esc="(ip.discharge_date - ip.hosp_date).days if ip.hosp_date and ip.discharge_date else 0"/></td>
                                <td><t t-esc="ip.state"/></td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="table-info">
                            <td colspan="8"><strong>Total Inpatients: <t t-esc="len(docs)"/></strong></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </t>
    </t>
</template>

<!-- #4 IP Discharge & Billing Summary -->
<template id="report_ip_billing">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="text-center mb-4">
                    <h2>IP Discharge &amp; Billing Summary</h2>
                </div>
                <t t-foreach="docs" t-as="ip">
                    <div class="mb-4">
                        <table class="table table-bordered">
                            <tr><td><b>IP Reference</b></td><td><t t-esc="ip.name"/></td>
                                <td><b>Patient</b></td><td><t t-esc="ip.patient_id.name"/></td></tr>
                            <tr><td><b>Admitted</b></td><td><t t-esc="ip.hosp_date"/></td>
                                <td><b>Discharged</b></td><td><t t-esc="ip.discharge_date or 'Active'"/></td></tr>
                            <tr><td><b>Doctor</b></td><td><t t-esc="ip.attending_doctor_id.name or '-'"/></td>
                                <td><b>Room</b></td><td><t t-esc="ip.room_id.name if ip.room_id else '-'"/></td></tr>
                            <tr><td><b>Days</b></td><td><t t-esc="(ip.discharge_date - ip.hosp_date).days if ip.hosp_date and ip.discharge_date else 0"/></td>
                                <td><b>Category</b></td><td><t t-esc="ip.patient_category or '-'"/></td></tr>
                        </table>
                        <table class="table table-bordered">
                            <thead class="table-secondary"><tr><th>Charge Head</th><th class="text-end">Amount</th></tr></thead>
                            <tbody>
                                <tr><td>Room Charges</td><td class="text-end">₹ <t t-esc="'%.2f' % (ip.room_id.rent or 0)"/></td></tr>
                                <tr><td>Bed Charges</td><td class="text-end">₹ <t t-esc="'%.2f' % (ip.bed_id.bed_rent or 0)"/></td></tr>
                                <tr><td>Service Charges</td><td class="text-end">₹ <t t-esc="'%.2f' % (ip.service_charge or 0)"/></td></tr>
                                <tr><td>OT / Surgical Charges</td><td class="text-end">₹ <t t-esc="'%.2f' % (ip.ot_charge or 0)"/></td></tr>
                                <tr><td>Food Charges</td><td class="text-end">₹ <t t-esc="'%.2f' % sum(s.charge or 0 for s in ip.food_supply_ids)"/></td></tr>
                                <tr><td>Less: Advance</td><td class="text-end">- ₹ <t t-esc="'%.2f' % (ip.advance_amount or 0)"/></td></tr>
                            </tbody>
                            <tfoot>
                                <tr class="table-success">
                                    <td><strong>Net Payable</strong></td>
                                    <td class="text-end"><strong>₹ <t t-esc="'%.2f' % ((ip.room_id.rent or 0) + (ip.bed_id.bed_rent or 0) + (ip.service_charge or 0) + (ip.ot_charge or 0) + sum(s.charge or 0 for s in ip.food_supply_ids) - (ip.advance_amount or 0))"/></strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </div>
        </t>
    </t>
</template>

<!-- #5 Pharmacy Dispensing Report -->
<template id="report_pharmacy_dispensing">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="text-center mb-4">
                    <h2>Pharmacy Dispensing Report</h2>
                </div>
                <table class="table table-bordered table-sm">
                    <thead class="table-primary">
                        <tr>
                            <th>Order Ref</th>
                            <th>Date</th>
                            <th>Patient</th>
                            <th>Type</th>
                            <th>Items</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="order">
                            <tr>
                                <td><t t-esc="order.name"/></td>
                                <td><t t-esc="order.date_order" t-options="{'widget': 'date'}"/></td>
                                <td><t t-esc="order.partner_id.name"/></td>
                                <td><t t-esc="order.dispensing_category or 'OP'"/></td>
                                <td><t t-esc="len(order.order_line)"/></td>
                                <td>₹ <t t-esc="'%.2f' % order.amount_total"/></td>
                                <td><t t-esc="order.state"/></td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="table-success">
                            <td colspan="5"><strong>Total Orders: <t t-esc="len(docs)"/></strong></td>
                            <td><strong>₹ <t t-esc="'%.2f' % sum(o.amount_total for o in docs)"/></strong></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </t>
    </t>
</template>

<!-- #7 Batch Expiry Report -->
<template id="report_batch_expiry">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="text-center mb-4">
                    <h2>Batch Expiry Inventory Report</h2>
                </div>
                <table class="table table-bordered table-sm">
                    <thead class="table-primary">
                        <tr>
                            <th>Product</th>
                            <th>Batch / Lot</th>
                            <th>Expiry Date</th>
                            <th>Qty on Hand</th>
                            <th>Location</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="lot">
                            <tr t-attf-class="{{ 'table-danger' if lot.expiration_date and lot.expiration_date.date() &amp;lt; today else ('table-warning' if lot.expiration_date else '') }}">
                                <td><t t-esc="lot.product_id.name"/></td>
                                <td><t t-esc="lot.name"/></td>
                                <td><t t-esc="lot.expiration_date or 'No Expiry'"/></td>
                                <td><t t-esc="lot.product_qty"/></td>
                                <td><t t-esc="lot.company_id.name"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <p><span class="badge bg-danger">Red</span> = Expired  #160;
                   <span class="badge bg-warning text-dark">Yellow</span> = No expiry date</p>
            </div>
        </t>
    </t>
</template>

<!-- #8 Lab Test Report -->
<template id="report_lab_tests">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="text-center mb-4">
                    <h2>Lab Test Report</h2>
                </div>
                <t t-foreach="docs" t-as="lab">
                    <div class="mb-4">
                        <h4><t t-esc="lab.test_id.name"/> — <t t-esc="lab.patient_id.name"/></h4>
                        <p>Date: <t t-esc="lab.date"/> | Status: <t t-esc="lab.state"/></p>
                        <table class="table table-bordered table-sm">
                            <thead class="table-secondary">
                                <tr><th>Test</th><th>Result</th><th>Normal Range</th><th>Unit</th><th>Abnormal</th></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="lab.result_ids" t-as="result">
                                    <tr t-attf-class="{{ 'table-danger' if result.is_abnormal else '' }}">
                                        <td><t t-esc="result.test_id.name if result.test_id else '-'"/></td>
                                        <td><strong><t t-esc="result.result or '-'"/></strong></td>
                                        <td><t t-esc="result.normal or '-'"/></td>
                                        <td><t t-esc="result.unit or '-'"/></td>
                                        <td><t t-esc="'⚠ YES' if result.is_abnormal else 'No'"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </div>
        </t>
    </t>
</template>

<!-- #11 Room Occupancy Report -->
<template id="report_room_occupancy">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="text-center mb-4">
                    <h2>Room Occupancy Report</h2>
                    <h4>As on: <t t-esc="today"/></h4>
                </div>
                <table class="table table-bordered">
                    <thead class="table-primary">
                        <tr><th>Room</th><th>Type</th><th>Rent/Day</th><th>Status</th><th>Current Patient</th><th>Admitted On</th></tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="room">
                            <t t-set="ip" t-value="room.env['hospital.inpatient'].search([('room_id','=',room.id),('state','in',['admit','invoice'])], limit=1)"/>
                            <tr t-attf-class="{{ 'table-danger' if room.state == 'not' else ('table-warning' if room.state == 'cleaning' else 'table-success') }}">
                                <td><t t-esc="room.name"/></td>
                                <td><t t-esc="room.bed_type or '-'"/></td>
                                <td>₹ <t t-esc="'%.2f' % (room.rent or 0)"/></td>
                                <td><t t-esc="room.state"/></td>
                                <td><t t-esc="ip.patient_id.name if ip else '-'"/></td>
                                <td><t t-esc="ip.hosp_date if ip else '-'"/></td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="table-info">
                            <td colspan="3"><strong>Total Rooms: <t t-esc="len(docs)"/></strong></td>
                            <td><strong>Occupied: <t t-esc="len(docs.filtered(lambda r: r.state == 'not'))"/></strong></td>
                            <td><strong>Available: <t t-esc="len(docs.filtered(lambda r: r.state == 'avail'))"/></strong></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </t>
    </t>
</template>

<!-- #14 Follow-Up Due Report -->
<template id="report_followup_due">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="text-center mb-4">
                    <h2>Follow-Up Due Report</h2>
                    <h4>Date: <t t-esc="today"/></h4>
                </div>
                <table class="table table-bordered">
