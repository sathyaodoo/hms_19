<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_op_assessment" model="ir.actions.report">
        <field name="name">Initial Assessment Sheet - OP</field>
        <field name="model">hospital.op.assessment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">santhigiri_hms.report_op_assessment</field>
        <field name="print_report_name">'Initial_Assessment_' + (object.reference or '')</field>
        <field name="binding_model_id" ref="model_hospital_op_assessment"/>
    </record>

    <template id="report_op_assessment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <div class="text-center">
                            <p>Gurucharanam Saranam</p>
                            <h3>Santhigiri Ayurveda Medical College Hospital</h3>
                            <h4><i>Initial Assessment Sheet - O P</i></h4>
                            <p>Form No : SAMC/CS/11</p>
                        </div>
                        <table class="table table-borderless">
                            <tr>
                                <td><strong>Date:</strong>
                                    <t t-esc="doc.assessment_date_display"/></td>
                                <td><strong>Time:</strong>
                                    <t t-esc="doc.assessment_time_display"/></td>
                            </tr>
                            <tr>
                                <td colspan="2"><strong>Patient's Name:</strong>
                                    <t t-esc="doc.patient_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Age:</strong> <t t-esc="doc.patient_id.age"/></td>
                                <td><strong>Sex:</strong> <t t-esc="doc.patient_id.gender"/></td>
                            </tr>
                            <tr>
                                <td><strong>UHID No:</strong> <t t-esc="doc.uhid_no"/></td>
                                <td><strong>COP No:</strong> <t t-esc="doc.cop_no"/></td>
                            </tr>
                            <tr>
                                <td><strong>DOP No:</strong> <t t-esc="doc.dop_no"/></td>
                                <td><strong>Department:</strong>
                                    <t t-esc="doc.department_id.name or ''"/></td>
                            </tr>
                            <tr>
                                <td colspan="2"><strong>Consultant:</strong>
                                    <t t-esc="doc.doctor_id.display_name or ''"/></td>
                            </tr>
                        </table>

                        <h5>Vitals</h5>
                        <table class="table table-bordered table-sm">
                            <tr>
                                <td>Respiratory Rate</td><td><t t-esc="doc.respiratory_rate"/></td>
                                <td>Heart Rate</td><td><t t-esc="doc.heart_rate"/></td>
                                <td>Pulse Rate</td><td><t t-esc="doc.pulse_rate"/></td>
                            </tr>
                            <tr>
                                <td>Height</td><td><t t-esc="doc.height"/> cm</td>
                                <td>Weight</td><td><t t-esc="doc.weight"/> kg</td>
                                <td>BMI</td><td><t t-esc="doc.bmi"/></td>
                            </tr>
                            <tr>
                                <td>BP</td><td><t t-esc="doc.bp"/></td>
                                <td>Temp.</td><td><t t-esc="doc.temperature"/></td>
                                <td>GRBS</td><td><t t-esc="doc.grbs"/></td>
                            </tr>
                        </table>

                        <p><strong>Nutritional screening:</strong>
                            <t t-esc="dict(doc._fields['nutritional_screening'].selection)
                                       .get(doc.nutritional_screening, '')"/></p>

                        <p><strong>Presenting complaints and duration:</strong></p>
                        <p><t t-esc="doc.presenting_complaints or doc.outpatient_id.chief_complaint or ''"/></p>

                        <p><strong>Pain Assessment:</strong>
                            <t t-esc="dict(doc._fields['pain_score'].selection)
                                       .get(doc.pain_score, '')"/></p>

                        <p><strong>Current Medication:</strong>
                            <t t-esc="doc.current_medication or ''"/></p>
                        <p><strong>Treatment History:</strong>
                            <t t-esc="doc.treatment_history or ''"/></p>
                        <p><strong>History of Allergy:</strong>
                            <t t-esc="doc.patient_id.allergy_summary or 'NIL'"/></p>
                        <p><strong>Investigations Recommended:</strong>
                            <t t-esc="doc.investigations_recommended or ''"/></p>
                        <p><strong>Diagnosis:</strong>
                            <t t-esc="doc.outpatient_id.provisional_diagnosis or ''"/></p>

                        <div style="page-break-before: always;"/>

                        <h5>Care Plan Strategy</h5>
                        <table class="table table-borderless">
                            <tr>
                                <td><strong>Curative:</strong> <t t-esc="doc.care_plan_curative"/></td>
                            </tr>
                            <tr>
                                <td><strong>Preventive:</strong> <t t-esc="doc.care_plan_preventive"/></td>
                            </tr>
                            <tr>
                                <td><strong>Rehabilitative:</strong> <t t-esc="doc.care_plan_rehabilitative"/></td>
                            </tr>
                        </table>
                        <p><strong>Care plan with desired outcome:</strong>
                            <t t-esc="doc.care_plan_outcome or ''"/></p>

                        <h5>Medication Order</h5>
                        <table class="table table-bordered table-sm">
                            <thead>
                                <tr>
                                    <th>Sl. No.</th><th>Medicine</th><th>Route</th>
                                    <th>Dose</th><th>Time</th><th>Anupana</th><th>Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.outpatient_id.prescription_ids" t-as="line">
                                    <tr>
                                        <td><t t-esc="line_index + 1"/></td>
                                        <td><t t-esc="line.medicine_id.name"/></td>
                                        <td><t t-esc="line.route"/></td>
                                        <td><t t-esc="line.no_intakes"/></td>
                                        <td><t t-esc="line.time"/></td>
                                        <td><t t-esc="line.anupanam"/></td>
                                        <td><t t-esc="line.duration_days"/> days</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <h5>Treatment Order</h5>
                        <table class="table table-bordered table-sm">
                            <thead>
                                <tr>
                                    <th>Sl. No.</th><th>Procedure Name</th><th>Medicine(s)</th>
                                    <th>Site / Location</th><th>Duration</th><th>Precautions if any</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.outpatient_id.procedure_prescription_ids" t-as="proc">
                                    <tr>
                                        <td><t t-esc="proc_index + 1"/></td>
                                        <td><t t-esc="proc.procedure_id.name"/></td>
                                        <td>
                                            <t t-foreach="proc.procedure_medicine_ids" t-as="pm">
                                                <t t-esc="pm.medicine_id.name"/><br/>
                                            </t>
                                        </td>
                                        <td><t t-esc="proc.site_location"/></td>
                                        <td><t t-esc="proc.no_of_sessions"/> sessions</td>
                                        <td><t t-esc="proc.precautions"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <table class="table table-borderless mt-4">
                            <tr>
                                <td><strong>Date:</strong>
                                    <t t-esc="doc.signoff_date"/></td>
                                <td><strong>Time:</strong>
                                    <t t-esc="doc.signoff_time"/></td>
                            </tr>
                            <tr>
                                <td colspan="2"><strong>Name and signature of the consultant:</strong>
                                    <t t-esc="doc.consultant_signoff_id.name or ''"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>