<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <data noupdate="1">

        <!-- Base group (all hospital staff) -->
        <record id="group_hospital_santhigiri_base" model="res.groups">
            <field name="name">Santhigiri HMS — Base</field>
            <field name="implied_ids"
                   eval="[(4, ref('base_hospital_management.group_hospital_management'))]"/>
        </record>


        <!-- RMO -->
        <record id="group_rmo" model="res.groups">
            <field name="name">RMO (Resident Medical Officer)</field>
            <field name="implied_ids"
                   eval="[(4, ref('group_hospital_santhigiri_base'))]"/>
        </record>


        <!-- Therapist -->
        <record id="group_therapist" model="res.groups">
            <field name="name">Therapist / Panchakarma Staff</field>
            <field name="implied_ids"
                   eval="[(4, ref('group_hospital_santhigiri_base'))]"/>
        </record>


        <!-- Dietitian -->
        <record id="group_dietitian" model="res.groups">
            <field name="name">Dietitian</field>
            <field name="implied_ids"
                   eval="[(4, ref('group_hospital_santhigiri_base'))]"/>
        </record>


        <!-- Deputy Medical Superintendent -->
        <record id="group_dms" model="res.groups">
            <field name="name">Deputy Medical Superintendent (DMS)</field>
            <field name="implied_ids"
                   eval="[(4, ref('group_hospital_santhigiri_base'))]"/>
        </record>


        <!-- Nursing Superintendent -->
        <record id="group_nursing_superintendent" model="res.groups">
            <field name="name">Nursing Superintendent</field>
            <field name="implied_ids"
                   eval="[(4, ref('base_hospital_management.base_hospital_management_group_nurse'))]"/>
        </record>


        <!-- Assistant Matron -->
        <record id="group_assistant_matron" model="res.groups">
            <field name="name">Assistant Matron</field>
            <field name="implied_ids"
                   eval="[(4, ref('base_hospital_management.base_hospital_management_group_nurse'))]"/>
        </record>


        <!-- Office Superintendent -->
        <record id="group_office_superintendent" model="res.groups">
            <field name="name">
                Office Superintendent (Security / Housekeeping / Food)
            </field>
            <field name="implied_ids"
                   eval="[(4, ref('group_hospital_santhigiri_base'))]"/>
        </record>


        <!-- X-Ray Technician -->
        <record id="group_xray_technician" model="res.groups">
            <field name="name">X-Ray Technician</field>
            <field name="implied_ids"
                   eval="[(4, ref('base_hospital_management.base_hospital_management_group_lab_assistant'))]"/>
        </record>


        <!-- Housekeeping Staff -->
        <record id="group_housekeeping" model="res.groups">
            <field name="name">Housekeeping Staff</field>
            <field name="implied_ids"
                   eval="[(4, ref('group_hospital_santhigiri_base'))]"/>
        </record>


        <!-- Intern / Medical Student -->
        <record id="group_intern" model="res.groups">
            <field name="name">Medical Intern / Student</field>
            <field name="implied_ids"
                   eval="[(4, ref('group_hospital_santhigiri_base'))]"/>
        </record>

    </data>

    <record id="group_hide_menu_for_specific_company" model="res.groups">
        <field name="name">Hide Menu for Specific Company</field>
    </record>

</odoo>